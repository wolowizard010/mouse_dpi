---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCleanPath } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}

const {
  title = "Mouse DPI Analyze — Accurate Measurement Tool",
  description = "Measure your mouse DPI with precision. Free online Mouse DPI Analyze tool with screen calibration and real-time calculation.",
  image = "/og-image.png",
} = Astro.props;

const lang = Astro.currentLocale || "en";
const relativePath = getCleanPath(Astro.url.pathname);
const siteUrl = Astro.site || new URL("https://mymousedpi.com");
const canonical = new URL(getRelativeLocaleUrl(lang, relativePath), siteUrl).href;

const siteName = "My Mouse DPI";
const locales = ["de", "fr", "es", "it", "nl", "pl", "pt", "ru", "zh", "sv", "da", "no", "fi"];
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8MPFKBMX52"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPFKBMX52');
    </script>
    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1258667075512239" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MouseDPI" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme: apply before paint to prevent flash -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang Alternate Links for International SEO -->
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl("en", relativePath), siteUrl).href} />
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl("en", relativePath), siteUrl).href} />
    {locales.map((locale) => {
      const hreflang = locale === "zh" ? "zh-Hans" : locale;
      return (
        <link
          rel="alternate"
          hreflang={hreflang}
          href={new URL(getRelativeLocaleUrl(locale, relativePath), siteUrl).href}
        />
      );
    })}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Fonts: Geist Sans + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": siteName,
      "url": "https://mymousedpi.com",
      "description": description,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

---
// ScreenRuler.astro — On-screen ruler with calibration
// Uses credit-card calibration or manual screen-size entry for accurate PPI
---

<section class="ruler-section" id="screen-ruler">
  <div class="ruler-controls card" id="ruler-controls">
    <h3 class="display-sm" style="margin: 0 0 16px;">Calibration</h3>
    <p class="body-sm" style="color: var(--color-body); margin: 0 0 16px;">
      Calibrate your screen for accurate measurements. Choose a method below.
    </p>

    <!-- Calibration method tabs -->
    <div class="calibration-tabs">
      <button class="unit-btn active" data-method="card" id="cal-method-card">Credit Card</button>
      <button class="unit-btn" data-method="manual" id="cal-method-manual">Manual Entry</button>
    </div>

    <!-- Credit card calibration -->
    <div class="calibration-panel" id="cal-panel-card">
      <p class="body-sm" style="color: var(--color-body); margin: 8px 0 12px;">
        Place a standard credit card (85.6mm) against the line below and adjust the slider until they match.
      </p>
      <div class="card-calibration-visual" id="card-calibration-visual">
        <div class="card-line" id="card-line">
          <div class="card-line-inner"></div>
          <span class="card-line-label code-text">85.6 mm</span>
        </div>
      </div>
      <div class="slider-group">
        <label class="caption-mono" style="color: var(--color-mute);">Adjust size</label>
        <input
          type="range"
          class="calibration-slider"
          id="calibration-slider"
          min="60"
          max="200"
          value="96"
          step="0.5"
        />
        <span class="code-text" id="ppi-display">96 PPI</span>
      </div>
    </div>

    <!-- Manual calibration -->
    <div class="calibration-panel" id="cal-panel-manual" style="display: none;">
      <div class="manual-fields">
        <div class="setting-group">
          <label class="setting-label body-sm">Screen diagonal (inches)</label>
          <input
            type="number"
            class="input"
            id="screen-diagonal"
            placeholder="e.g. 15.6"
            min="5"
            max="50"
            step="0.1"
          />
        </div>
        <div class="setting-group">
          <label class="setting-label body-sm">Resolution</label>
          <div class="resolution-inputs">
            <input
              type="number"
              class="input"
              id="screen-width"
              placeholder="1920"
              min="320"
              max="7680"
            />
            <span class="body-sm" style="color: var(--color-mute);">×</span>
            <input
              type="number"
              class="input"
              id="screen-height"
              placeholder="1080"
              min="200"
              max="4320"
            />
          </div>
        </div>
        <button class="btn btn-primary btn-sm" id="calc-ppi-btn" style="width: 100%;">Calculate PPI</button>
      </div>
    </div>

    <!-- Unit toggle -->
    <div style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center;">
      <span class="body-sm" style="color: var(--color-body); font-weight: 500;">Ruler unit</span>
      <div class="unit-toggle" id="ruler-unit-toggle">
        <button class="unit-btn active" data-unit="cm" id="ruler-unit-cm">cm</button>
        <button class="unit-btn" data-unit="inch" id="ruler-unit-inch">inch</button>
      </div>
    </div>

    <!-- Calibration status -->
    <div class="calibration-status" id="calibration-status">
      <div class="status-dot" id="status-dot"></div>
      <span class="body-sm" id="calibration-status-text">Using default (96 PPI)</span>
    </div>
  </div>

  <!-- The Ruler -->
  <div class="ruler-display card" id="ruler-display">
    <div class="ruler-canvas-wrapper">
      <canvas id="ruler-canvas" width="800" height="120"></canvas>
    </div>
    <div class="ruler-info">
      <span class="caption-mono" style="color: var(--color-mute);">
        Drag the ruler edges to resize · Use calibration for accuracy
      </span>
    </div>
  </div>
</section>

<style>
  .ruler-section {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    align-items: start;
  }

  .ruler-controls {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .calibration-tabs {
    display: flex;
    background: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
    padding: 2px;
    gap: 2px;
    margin-bottom: 16px;
  }

  .calibration-tabs .unit-btn {
    flex: 1;
  }

  .calibration-panel {
    padding: 0;
  }

  .card-calibration-visual {
    background: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    padding: 20px;
    margin-bottom: 16px;
  }

  .card-line {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-line-inner {
    height: 4px;
    background: linear-gradient(90deg, var(--color-grad-develop-start), var(--color-grad-develop-end));
    border-radius: 2px;
    transition: width 0.1s ease;
  }

  .card-line-label {
    white-space: nowrap;
    color: var(--color-body);
  }

  .slider-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .calibration-slider {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: var(--color-hairline);
    border-radius: 2px;
    outline: none;
  }

  .calibration-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    background: var(--color-ink);
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .calibration-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .manual-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .resolution-inputs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .resolution-inputs .input {
    flex: 1;
  }

  .calibration-status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 10px 12px;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-warning);
    flex-shrink: 0;
  }

  .status-dot.calibrated {
    background: var(--color-success);
  }

  .ruler-display {
    padding: 24px;
    overflow: hidden;
  }

  .ruler-canvas-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-sm);
  }

  #ruler-canvas {
    display: block;
    width: 100%;
    min-height: 120px;
  }

  .ruler-info {
    margin-top: 12px;
    text-align: center;
  }

  .setting-group {
    margin-bottom: 0;
  }

  .setting-label {
    display: block;
    color: var(--color-body);
    margin-bottom: 6px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .ruler-section {
      grid-template-columns: 1fr;
    }

    .ruler-controls {
      position: static;
    }
  }
</style>

<script>
  // ─── Screen Ruler Engine ───
  const canvas = document.getElementById("ruler-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const calibrationSlider = document.getElementById("calibration-slider") as HTMLInputElement;
  const ppiDisplay = document.getElementById("ppi-display") as HTMLElement;
  const cardLineInner = document.querySelector(".card-line-inner") as HTMLElement;
  const statusDot = document.getElementById("status-dot") as HTMLElement;
  const statusText = document.getElementById("calibration-status-text") as HTMLElement;
  const calcPpiBtn = document.getElementById("calc-ppi-btn") as HTMLButtonElement;

  let currentPPI = 96; // Default PPI
  let rulerUnit: "cm" | "inch" = "cm";
  let isCalibrated = false;

  // Try to load saved PPI
  const savedPPI = localStorage.getItem("screenPPI");
  if (savedPPI) {
    currentPPI = parseFloat(savedPPI);
    calibrationSlider.value = String(currentPPI);
    isCalibrated = true;
    updateCalibrationStatus();
  }

  // Calibration method tabs
  document.querySelectorAll(".calibration-tabs .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".calibration-tabs .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const method = (btn as HTMLElement).dataset.method;
      (document.getElementById("cal-panel-card") as HTMLElement).style.display = method === "card" ? "block" : "none";
      (document.getElementById("cal-panel-manual") as HTMLElement).style.display = method === "manual" ? "block" : "none";
    });
  });

  // Ruler unit toggle
  document.querySelectorAll("#ruler-unit-toggle .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#ruler-unit-toggle .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      rulerUnit = (btn as HTMLElement).dataset.unit as "cm" | "inch";
      drawRuler();
    });
  });

  // Slider calibration
  calibrationSlider.addEventListener("input", () => {
    currentPPI = parseFloat(calibrationSlider.value);
    updateCardLine();
    updateCalibrationStatus();
    drawRuler();
    savePPI();
  });

  function updateCardLine() {
    // Credit card is 85.6mm = 3.37 inches
    const creditCardPixels = (85.6 / 25.4) * currentPPI;
    if (cardLineInner) {
      cardLineInner.style.width = `${creditCardPixels}px`;
    }
    if (ppiDisplay) {
      ppiDisplay.textContent = `${Math.round(currentPPI)} PPI`;
    }
  }

  function updateCalibrationStatus() {
    isCalibrated = true;
    if (statusDot) statusDot.classList.add("calibrated");
    if (statusText) statusText.textContent = `Calibrated: ${Math.round(currentPPI)} PPI`;
  }

  function savePPI() {
    localStorage.setItem("screenPPI", String(currentPPI));
  }

  // Manual PPI calculation
  calcPpiBtn?.addEventListener("click", () => {
    const diagonal = parseFloat((document.getElementById("screen-diagonal") as HTMLInputElement).value);
    const width = parseInt((document.getElementById("screen-width") as HTMLInputElement).value);
    const height = parseInt((document.getElementById("screen-height") as HTMLInputElement).value);

    if (diagonal > 0 && width > 0 && height > 0) {
      const diagonalPixels = Math.sqrt(width * width + height * height);
      currentPPI = diagonalPixels / diagonal;
      calibrationSlider.value = String(Math.round(currentPPI));
      updateCardLine();
      updateCalibrationStatus();
      drawRuler();
      savePPI();
    }
  });

  // ─── Draw Ruler ───
  function drawRuler() {
    const dpr = window.devicePixelRatio || 1;
    const displayWidth = canvas.parentElement!.clientWidth;
    const displayHeight = 120;

    canvas.width = displayWidth * dpr;
    canvas.height = displayHeight * dpr;
    canvas.style.width = `${displayWidth}px`;
    canvas.style.height = `${displayHeight}px`;
    ctx.scale(dpr, dpr);

    // Clear
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, displayWidth, displayHeight);

    const pixelsPerUnit = rulerUnit === "cm"
      ? currentPPI / 2.54  // pixels per cm
      : currentPPI;         // pixels per inch

    const subdivisionsPerUnit = rulerUnit === "cm" ? 10 : 16; // mm or 1/16 inch
    const pixelsPerSubdivision = pixelsPerUnit / subdivisionsPerUnit;

    const totalUnits = Math.floor(displayWidth / pixelsPerUnit) + 1;

    // Draw ruler body
    ctx.fillStyle = "#fafafa";
    ctx.fillRect(0, 0, displayWidth, 80);

    // Draw top border
    ctx.fillStyle = "#171717";
    ctx.fillRect(0, 0, displayWidth, 2);

    // Draw ticks
    for (let unit = 0; unit <= totalUnits; unit++) {
      for (let sub = 0; sub < subdivisionsPerUnit; sub++) {
        const x = unit * pixelsPerUnit + sub * pixelsPerSubdivision;
        if (x > displayWidth) break;

        let tickHeight: number;
        let tickWidth: number;
        let color: string;

        if (sub === 0) {
          // Major tick (full unit)
          tickHeight = 40;
          tickWidth = 1.5;
          color = "#171717";
        } else if (rulerUnit === "cm" && sub === 5) {
          // Half cm
          tickHeight = 28;
          tickWidth = 1;
          color = "#4d4d4d";
        } else if (rulerUnit === "inch" && sub === 8) {
          // Half inch
          tickHeight = 28;
          tickWidth = 1;
          color = "#4d4d4d";
        } else if (rulerUnit === "inch" && (sub === 4 || sub === 12)) {
          // Quarter inch
          tickHeight = 20;
          tickWidth = 1;
          color = "#888888";
        } else {
          // Minor tick
          tickHeight = 12;
          tickWidth = 0.5;
          color = "#cccccc";
        }

        ctx.fillStyle = color;
        ctx.fillRect(Math.round(x) - tickWidth / 2, 2, tickWidth, tickHeight);

        // Draw unit label
        if (sub === 0 && unit > 0) {
          ctx.fillStyle = "#171717";
          ctx.font = "500 13px 'Geist', 'Inter', system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(String(unit), Math.round(x), 60);
        }
      }
    }

    // Draw unit label at origin
    ctx.fillStyle = "#888888";
    ctx.font = "400 11px 'Geist Mono', monospace";
    ctx.textAlign = "left";
    ctx.fillText(rulerUnit === "cm" ? "cm" : "inches", 6, 75);

    // Draw bottom edge
    ctx.fillStyle = "#ebebeb";
    ctx.fillRect(0, 79, displayWidth, 1);

    // Info area
    ctx.fillStyle = "#fafafa";
    ctx.fillRect(0, 80, displayWidth, 40);
    ctx.fillStyle = "#888888";
    ctx.font = "400 11px 'Geist Mono', monospace";
    ctx.textAlign = "center";
    ctx.fillText(`Screen PPI: ${Math.round(currentPPI)} · ${rulerUnit === "cm" ? "Centimeters" : "Inches"}`, displayWidth / 2, 105);
  }

  // Initialize
  updateCardLine();
  drawRuler();

  // Redraw on resize
  window.addEventListener("resize", () => {
    drawRuler();
  });

  // Dispatch PPI to DPI tool if it exists
  function dispatchPPI() {
    window.dispatchEvent(new CustomEvent("ppi-updated", { detail: { ppi: currentPPI } }));
  }

  calibrationSlider.addEventListener("change", dispatchPPI);
  calcPpiBtn?.addEventListener("click", () => setTimeout(dispatchPPI, 100));
</script>

---
// ScreenRuler.astro — On-screen ruler with manual screen calibration
// Uses screen diagonal + resolution for accurate PPI calculation
---

<section class="ruler-section" id="screen-ruler">
  <div class="ruler-controls card" id="ruler-controls">
    <h3 class="display-sm" style="margin: 0 0 16px;">Calibration</h3>
    <p class="body-sm" style="color: var(--color-body); margin: 0 0 16px;">
      Enter your screen specifications for accurate measurements.
    </p>

    <div class="unit-toggle" id="ruler-calibration-mode-toggle" style="margin-bottom: 16px; display: flex; width: 100%;">
      <button class="unit-btn active" data-mode="preset" style="flex: 1; text-align: center;">Presets</button>
      <button class="unit-btn" data-mode="manual" style="flex: 1; text-align: center;">Manual</button>
    </div>

    <div id="ruler-preset-group">
      <div class="setting-group">
        <label class="setting-label body-sm">Select Monitor</label>
        <select class="input" id="ruler-preset-select" style="width: 100%; cursor: pointer;">
          <!-- Options populated by JS -->
        </select>
      </div>
    </div>

    <!-- Manual calibration fields -->
    <div class="manual-fields" id="ruler-manual-entry-section" style="display: none;">
      <div class="setting-group">
        <label class="setting-label body-sm">Screen diagonal (inches)</label>
        <input
          type="number"
          class="input"
          id="screen-diagonal"
          placeholder="e.g. 15.6"
          min="5"
          max="100"
          step="0.1"
        />
      </div>
      <div class="setting-group">
        <label class="setting-label body-sm">Resolution</label>
        <div class="resolution-inputs">
          <input
            type="number"
            class="input"
            id="screen-width"
            placeholder="1920"
            min="320"
            max="7680"
          />
          <span class="body-sm" style="color: var(--color-mute);">×</span>
          <input
            type="number"
            class="input"
            id="screen-height"
            placeholder="1080"
            min="200"
            max="4320"
          />
        </div>
      </div>
    </div>

    <button class="btn btn-primary btn-sm" id="calc-ppi-btn" style="width: 100%; margin-top: 12px;">Calculate PPI</button>

    <!-- Unit toggle -->
    <div style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center;">
      <span class="body-sm" style="color: var(--color-body); font-weight: 500;">Ruler unit</span>
      <div class="unit-toggle" id="ruler-unit-toggle">
        <button class="unit-btn active" data-unit="cm" id="ruler-unit-cm">cm</button>
        <button class="unit-btn" data-unit="inch" id="ruler-unit-inch">inch</button>
      </div>
    </div>

    <!-- Calibration status -->
    <div class="calibration-status" id="calibration-status">
      <div class="status-dot" id="status-dot"></div>
      <span class="body-sm" id="calibration-status-text">Using default (96 PPI)</span>
    </div>
  </div>

  <!-- The Ruler -->
  <div class="ruler-display card" id="ruler-display">
    <div class="ruler-canvas-wrapper">
      <canvas id="ruler-canvas" width="800" height="120"></canvas>
    </div>
    <div class="ruler-info">
      <span class="caption-mono" style="color: var(--color-mute);">
        Use calibration for accurate real-world measurements
      </span>
    </div>
  </div>
</section>

<style>
  .ruler-section {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    align-items: start;
  }

  .ruler-controls {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .detect-banner {
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    margin-bottom: 16px;
  }

  .manual-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .resolution-inputs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .resolution-inputs .input {
    flex: 1;
  }

  .calibration-status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 10px 12px;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-warning);
    flex-shrink: 0;
  }

  .status-dot.calibrated {
    background: var(--color-success);
  }

  .ruler-display {
    padding: 24px;
    overflow: hidden;
  }

  .ruler-canvas-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-sm);
  }

  #ruler-canvas {
    display: block;
    width: 100%;
    min-height: 120px;
  }

  .ruler-info {
    margin-top: 12px;
    text-align: center;
  }

  .setting-group {
    margin-bottom: 0;
  }

  .setting-label {
    display: block;
    color: var(--color-body);
    margin-bottom: 6px;
    font-weight: 500;
  }

  /* Unit toggle — prominent */
  .unit-toggle {
    display: flex;
    background: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
    padding: 2px;
    gap: 2px;
  }

  .unit-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 7px 14px;
    border: none;
    background: transparent;
    color: var(--color-body);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .unit-btn.active {
    background: var(--color-ink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .ruler-section {
      grid-template-columns: 1fr;
    }

    .ruler-controls {
      position: static;
    }
  }
</style>

<script>
  // ─── Screen Ruler Engine ───
  const canvas = document.getElementById("ruler-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const statusDot = document.getElementById("status-dot") as HTMLElement;
  const statusText = document.getElementById("calibration-status-text") as HTMLElement;
  const calcPpiBtn = document.getElementById("calc-ppi-btn") as HTMLButtonElement;

  let currentPPI = 96; // Default PPI (CSS pixels)
  let rulerUnit: "cm" | "inch" = "cm";
  let isCalibrated = false;
  let calibrationMode: "preset" | "manual" = "preset";

  const presetSelect = document.getElementById("ruler-preset-select") as HTMLSelectElement;
  const presetGroup = document.getElementById("ruler-preset-group") as HTMLElement;
  const manualEntrySection = document.getElementById("ruler-manual-entry-section") as HTMLElement;

  // Presets definition
  const MONITOR_PRESETS = [
    { diagonal: 13.3, w: 1920, h: 1080, name: '13.3" 1080p (Laptop)' },
    { diagonal: 14, w: 1920, h: 1080, name: '14" 1080p (Laptop)' },
    { diagonal: 15.6, w: 1920, h: 1080, name: '15.6" 1080p (Laptop)' },
    { diagonal: 14, w: 2560, h: 1600, name: '14" 1600p (Laptop)' },
    { diagonal: 16, w: 2560, h: 1600, name: '16" 1600p (Laptop)' },
    { diagonal: 16, w: 3456, h: 2234, name: '16" MacBook Pro' },
    { diagonal: 24, w: 1920, h: 1080, name: '24" 1080p' },
    { diagonal: 24.5, w: 1920, h: 1080, name: '24.5" 1080p' },
    { diagonal: 27, w: 1920, h: 1080, name: '27" 1080p' },
    { diagonal: 27, w: 2560, h: 1440, name: '27" 1440p' },
    { diagonal: 27, w: 3840, h: 2160, name: '27" 4K' },
    { diagonal: 32, w: 2560, h: 1440, name: '32" 1440p' },
    { diagonal: 32, w: 3840, h: 2160, name: '32" 4K' },
    { diagonal: 34, w: 3440, h: 1440, name: '34" Ultrawide' },
    { diagonal: 38, w: 3840, h: 1600, name: '38" Ultrawide' }
  ];

  function populatePresets() {
    if (!presetSelect) return;
    presetSelect.innerHTML = "";
    
    MONITOR_PRESETS.forEach((p, index) => {
      const option = document.createElement("option");
      option.value = index.toString();
      option.textContent = p.name;
      presetSelect.appendChild(option);
    });

    if (MONITOR_PRESETS.length > 0) {
      presetSelect.value = "0";
    }
  }

  populatePresets();

  // Calibration mode toggle
  document.querySelectorAll("#ruler-calibration-mode-toggle .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#ruler-calibration-mode-toggle .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      calibrationMode = (btn as HTMLElement).dataset.mode as "preset" | "manual";
      
      if (calibrationMode === "preset") {
        presetGroup.style.display = "block";
        manualEntrySection.style.display = "none";
      } else {
        presetGroup.style.display = "none";
        manualEntrySection.style.display = "block";
      }
    });
  });

  const dpr = window.devicePixelRatio || 1;

  // Try to load saved PPI
  const savedPPI = localStorage.getItem("screenPPI");
  if (savedPPI) {
    currentPPI = parseFloat(savedPPI);
    isCalibrated = true;
    updateCalibrationStatus();
  }

  // Ruler unit toggle
  document.querySelectorAll("#ruler-unit-toggle .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#ruler-unit-toggle .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      rulerUnit = (btn as HTMLElement).dataset.unit as "cm" | "inch";
      drawRuler();
    });
  });

  function updateCalibrationStatus() {
    isCalibrated = true;
    if (statusDot) statusDot.classList.add("calibrated");
    if (statusText) statusText.textContent = `Calibrated: ${Math.round(currentPPI)} PPI`;
  }

  function savePPI() {
    localStorage.setItem("screenPPI", String(currentPPI));
  }

  // PPI calculation
  calcPpiBtn?.addEventListener("click", () => {
    let diagonal = 0;
    let width = 0;
    let height = 0;
    
    if (calibrationMode === "preset") {
      const selectedIndex = parseInt(presetSelect.value);
      const preset = MONITOR_PRESETS[selectedIndex];
      if (preset) {
        diagonal = preset.diagonal;
        width = preset.w;
        height = preset.h;
      }
    } else {
      diagonal = parseFloat((document.getElementById("screen-diagonal") as HTMLInputElement).value);
      width = parseInt((document.getElementById("screen-width") as HTMLInputElement).value);
      height = parseInt((document.getElementById("screen-height") as HTMLInputElement).value);
    }

    if (diagonal > 0 && width > 0 && height > 0) {
      const diagonalPixels = Math.sqrt(width * width + height * height);
      // Physical PPI = diagonal pixels / diagonal inches
      const physicalPPI = diagonalPixels / diagonal;
      // Convert to CSS-pixel PPI (what the canvas uses)
      currentPPI = physicalPPI / dpr;
      updateCalibrationStatus();
      drawRuler();
      savePPI();

      // Dispatch PPI update
      dispatchPPI();
    } else {
      alert("Please ensure all fields are correctly filled.");
    }
  });

  // ─── Get theme-aware colors ───
  function getRulerColors() {
    const theme = document.documentElement.getAttribute("data-theme");
    const isDark = theme === "dark";

    return {
      background: isDark ? "#0a0a0a" : "#ffffff",
      rulerBody: isDark ? "#111111" : "#fafafa",
      topBorder: isDark ? "#ededed" : "#171717",
      majorTick: isDark ? "#ededed" : "#171717",
      halfTick: isDark ? "#a1a1a1" : "#4d4d4d",
      quarterTick: isDark ? "#666666" : "#888888",
      minorTick: isDark ? "#333333" : "#cccccc",
      labelColor: isDark ? "#ededed" : "#171717",
      unitLabel: isDark ? "#666666" : "#888888",
      dividerLine: isDark ? "#2a2a2a" : "#ebebeb",
      infoText: isDark ? "#666666" : "#888888",
    };
  }

  // ─── Draw Ruler ───
  function drawRuler() {
    const canvasDpr = window.devicePixelRatio || 1;
    const displayWidth = canvas.parentElement!.clientWidth;
    const displayHeight = 120;

    canvas.width = displayWidth * canvasDpr;
    canvas.height = displayHeight * canvasDpr;
    canvas.style.width = `${displayWidth}px`;
    canvas.style.height = `${displayHeight}px`;
    ctx.scale(canvasDpr, canvasDpr);

    const colors = getRulerColors();

    // Clear
    ctx.fillStyle = colors.background;
    ctx.fillRect(0, 0, displayWidth, displayHeight);

    const pixelsPerUnit = rulerUnit === "cm"
      ? currentPPI / 2.54  // CSS pixels per cm
      : currentPPI;         // CSS pixels per inch

    const subdivisionsPerUnit = rulerUnit === "cm" ? 10 : 16; // mm or 1/16 inch
    const pixelsPerSubdivision = pixelsPerUnit / subdivisionsPerUnit;

    const totalUnits = Math.floor(displayWidth / pixelsPerUnit) + 1;

    // Draw ruler body
    ctx.fillStyle = colors.rulerBody;
    ctx.fillRect(0, 0, displayWidth, 80);

    // Draw top border
    ctx.fillStyle = colors.topBorder;
    ctx.fillRect(0, 0, displayWidth, 2);

    // Draw ticks
    for (let unit = 0; unit <= totalUnits; unit++) {
      for (let sub = 0; sub < subdivisionsPerUnit; sub++) {
        const x = unit * pixelsPerUnit + sub * pixelsPerSubdivision;
        if (x > displayWidth) break;

        let tickHeight: number;
        let tickWidth: number;
        let color: string;

        if (sub === 0) {
          // Major tick (full unit)
          tickHeight = 40;
          tickWidth = 1.5;
          color = colors.majorTick;
        } else if (rulerUnit === "cm" && sub === 5) {
          // Half cm
          tickHeight = 28;
          tickWidth = 1;
          color = colors.halfTick;
        } else if (rulerUnit === "inch" && sub === 8) {
          // Half inch
          tickHeight = 28;
          tickWidth = 1;
          color = colors.halfTick;
        } else if (rulerUnit === "inch" && (sub === 4 || sub === 12)) {
          // Quarter inch
          tickHeight = 20;
          tickWidth = 1;
          color = colors.quarterTick;
        } else {
          // Minor tick
          tickHeight = 12;
          tickWidth = 0.5;
          color = colors.minorTick;
        }

        ctx.fillStyle = color;
        ctx.fillRect(Math.round(x) - tickWidth / 2, 2, tickWidth, tickHeight);

        // Draw unit label
        if (sub === 0 && unit > 0) {
          ctx.fillStyle = colors.labelColor;
          ctx.font = "500 13px 'Geist', 'Inter', system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(String(unit), Math.round(x), 60);
        }
      }
    }

    // Draw unit label at origin
    ctx.fillStyle = colors.unitLabel;
    ctx.font = "400 11px 'Geist Mono', monospace";
    ctx.textAlign = "left";
    ctx.fillText(rulerUnit === "cm" ? "cm" : "inches", 6, 75);

    // Draw bottom edge
    ctx.fillStyle = colors.dividerLine;
    ctx.fillRect(0, 79, displayWidth, 1);

    // Info area
    ctx.fillStyle = colors.rulerBody;
    ctx.fillRect(0, 80, displayWidth, 40);
    ctx.fillStyle = colors.infoText;
    ctx.font = "400 11px 'Geist Mono', monospace";
    ctx.textAlign = "center";
    ctx.fillText(`Screen PPI: ${Math.round(currentPPI)} · ${rulerUnit === "cm" ? "Centimeters" : "Inches"}`, displayWidth / 2, 105);
  }

  // Initialize
  drawRuler();

  // Redraw on resize
  window.addEventListener("resize", () => {
    drawRuler();
  });

  // Redraw when theme changes
  window.addEventListener("theme-changed", () => {
    drawRuler();
  });

  // Dispatch PPI to DPI tool if it exists
  function dispatchPPI() {
    window.dispatchEvent(new CustomEvent("ppi-updated", { detail: { ppi: currentPPI } }));
  }

  calcPpiBtn?.addEventListener("click", () => setTimeout(dispatchPPI, 100));
</script>

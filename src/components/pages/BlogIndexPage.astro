---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getBlogUi, getPostTranslation } from "../../i18n/blogI18n";
import type { SupportedLocale } from "../../i18n/ui";

const lang = (Astro.currentLocale || 'en') as SupportedLocale;
const blogUi = getBlogUi(lang);

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Map posts to localized display data
const localizedPosts = allPosts.map((p) => {
  const tr = getPostTranslation(p.id, lang);
  return {
    ...p,
    displayTitle: tr?.title || p.data.title,
    displayDescription: tr?.description || p.data.description,
    displayReadTime: tr?.readTime || p.data.readTime,
    displayCategory: tr?.category || p.data.category,
    displayTags: tr?.tags || p.data.tags || [],
    displayAuthorRole: tr?.authorRole || p.data.authorRole,
  };
});

const featuredPost = localizedPosts.find((p) => p.data.featured) || localizedPosts[0];

// Extract all unique categories
const categories = [blogUi.allCategories, ...new Set(localizedPosts.map((p) => p.displayCategory))];

function formatDate(date: Date) {
  const localeMap: Record<string, string> = {
    en: 'en-US', de: 'de-DE', fr: 'fr-FR', es: 'es-ES', it: 'it-IT',
    nl: 'nl-NL', pl: 'pl-PL', pt: 'pt-BR', ru: 'ru-RU', zh: 'zh-CN',
    sv: 'sv-SE', da: 'da-DK', no: 'nb-NO', fi: 'fi-FI',
  };
  return new Intl.DateTimeFormat(localeMap[lang] || 'en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
}
---

<Layout
  title={`${blogUi.title} — My Mouse DPI`}
  description={blogUi.subtitle}
>
  <Navbar />

  <main class="blog-index-page">
    <!-- Header / Hero -->
    <header class="blog-hero">
      <div class="container">
        <div class="blog-hero-content animate-fade-in">
          <div class="blog-pill-badge">
            <span class="blog-pill-dot"></span>
            <span>{blogUi.badge}</span>
          </div>
          <h1 class="display-xl blog-hero-title">
            {blogUi.title}
          </h1>
          <p class="body-lg blog-hero-subtitle">
            {blogUi.subtitle}
          </p>
          <div class="blog-hero-meta">
            <a href="/rss.xml" class="rss-link" title="Subscribe to RSS Feed" target="_blank">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
              <span>{blogUi.rssFeed}</span>
            </a>
            <span class="hero-dot">•</span>
            <span class="article-count">{blogUi.articlesCount(allPosts.length)}</span>
            <span class="hero-dot">•</span>
            <span>{blogUi.updatedRegularly}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <!-- Category & Search Bar -->
      <div class="filter-bar">
        <div class="categories-list" id="category-filter">
          {categories.map((cat, idx) => (
            <button
              class:list={["category-btn", { active: idx === 0 }]}
              data-category={idx === 0 ? "all" : cat}
            >
              {cat}
            </button>
          ))}
        </div>
        <div class="search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="blog-search"
            class="input search-input"
            placeholder={blogUi.searchPlaceholder}
            aria-label={blogUi.searchPlaceholder}
          />
        </div>
      </div>

      <!-- Featured Post (Hero Card) -->
      {featuredPost && (
        <section class="featured-section" id="featured-article">
          <div class="featured-card card animate-slide-up">
            <div class="featured-badge-bar">
              <span class="badge featured-pill">{blogUi.featuredBadge}</span>
              <span class="badge category-badge">{featuredPost.displayCategory}</span>
              <span class="read-time-pill caption-mono">{featuredPost.displayReadTime}</span>
            </div>

            <h2 class="featured-title">
              <a href={getRelativeLocaleUrl(lang, `blog/${featuredPost.id}`)}>
                {featuredPost.displayTitle}
              </a>
            </h2>

            <p class="featured-excerpt">
              {featuredPost.displayDescription}
            </p>

            <div class="featured-footer">
              <div class="author-block">
                <div class="author-avatar" aria-hidden="true">
                  {featuredPost.data.author.split(' ').map((n: string) => n[0]).join('')}
                </div>
                <div class="author-info">
                  <span class="author-name">{featuredPost.data.author}</span>
                  <span class="author-role">{featuredPost.displayAuthorRole}</span>
                </div>
              </div>

              <div class="featured-action">
                <time datetime={featuredPost.data.pubDate.toISOString()} class="featured-date">
                  {formatDate(featuredPost.data.pubDate)}
                </time>
                <a href={getRelativeLocaleUrl(lang, `blog/${featuredPost.id}`)} class="btn btn-primary btn-sm read-btn">
                  <span>{blogUi.readGuide}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Articles Grid -->
      <section class="articles-section">
        <h2 class="section-heading display-md">{blogUi.allArticlesHeading}</h2>
        
        <div class="articles-grid" id="articles-grid">
          {localizedPosts.map((post) => (
            <article class="post-card card" data-title={post.displayTitle.toLowerCase()} data-category={post.displayCategory}>
              <div class="post-card-header">
                <span class="badge category-badge">{post.displayCategory}</span>
                <span class="caption-mono post-read-time">{post.displayReadTime}</span>
              </div>

              <h3 class="post-card-title">
                <a href={getRelativeLocaleUrl(lang, `blog/${post.id}`)} class="post-title-link">
                  {post.displayTitle}
                </a>
              </h3>

              <p class="post-card-excerpt">
                {post.displayDescription}
              </p>

              {post.displayTags && post.displayTags.length > 0 && (
                <div class="post-tags">
                  {post.displayTags.slice(0, 3).map((tag: string) => (
                    <span class="post-tag">#{tag}</span>
                  ))}
                </div>
              )}

              <div class="post-card-footer">
                <div class="post-author-snippet">
                  <div class="author-avatar-sm" aria-hidden="true">
                    {post.data.author.split(' ').map((n: string) => n[0]).join('')}
                  </div>
                  <div class="post-author-details">
                    <span class="post-author-name">{post.data.author}</span>
                    <time datetime={post.data.pubDate.toISOString()} class="post-date">
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                </div>

                <a href={getRelativeLocaleUrl(lang, `blog/${post.id}`)} class="post-read-link" aria-label={`${blogUi.readGuide}: ${post.displayTitle}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="no-results" class="no-results" style="display: none;">
          <p class="body-md">{blogUi.noResults}</p>
        </div>
      </section>

      <!-- Practical Testing Callout Box -->
      <section class="tools-cta-box card-soft">
        <div class="cta-inner">
          <div class="cta-text">
            <span class="caption-mono" style="color: var(--color-link);">{blogUi.toolsCtaBadge}</span>
            <h3 class="display-md" style="margin: 8px 0;">{blogUi.toolsCtaTitle}</h3>
            <p class="body-md" style="color: var(--color-body); margin: 0;">
              {blogUi.toolsCtaDesc}
            </p>
          </div>
          <div class="cta-actions">
            <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary">
              {blogUi.launchDpiAnalyzer}
            </a>
            <a href={getRelativeLocaleUrl(lang, "screen-ruler")} class="btn btn-secondary">
              {blogUi.openScreenRuler}
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('blog-search');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const postCards = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-results');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterPosts() {
      let visibleCount = 0;

      postCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const matchesCat = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = !searchQuery || title.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterPosts();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterPosts();
      });
    }
  });
</script>

<style>
  .blog-index-page {
    padding: 32px 0 64px;
  }

  .blog-hero {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: 40px;
  }

  .blog-hero-content {
    max-width: 800px;
  }

  .blog-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body);
    margin-bottom: 20px;
  }

  .blog-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-link);
    box-shadow: 0 0 8px var(--color-link);
  }

  .blog-hero-title {
    margin: 0 0 16px;
    color: var(--color-ink);
  }

  .blog-hero-subtitle {
    color: var(--color-mute);
    margin: 0 0 24px;
    max-width: 680px;
  }

  .blog-hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--color-mute);
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-warning);
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .rss-link:hover {
    opacity: 0.8;
  }

  .hero-dot {
    opacity: 0.5;
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .categories-list {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .category-btn {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-body);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .category-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .category-btn.active {
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-color: var(--color-ink);
  }

  .search-box {
    position: relative;
    width: 280px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    pointer-events: none;
  }

  .search-input {
    padding-left: 36px;
    border-radius: var(--radius-pill);
  }

  /* Featured Article */
  .featured-section {
    margin-bottom: 56px;
  }

  .featured-card {
    padding: 40px;
    position: relative;
    overflow: hidden;
    background: var(--color-canvas);
    border-left: 4px solid var(--color-link);
  }

  .featured-badge-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .featured-pill {
    background: var(--color-link);
    color: #ffffff;
    font-weight: 500;
    border: none;
  }

  .category-badge {
    background: var(--color-canvas-soft-2);
    color: var(--color-body);
  }

  .read-time-pill {
    font-size: 12px;
    color: var(--color-mute);
    margin-left: auto;
  }

  .featured-title {
    font-size: 30px;
    line-height: 1.3;
    font-weight: 600;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .featured-title a {
    color: var(--color-ink);
    transition: color 0.15s ease;
  }

  .featured-title a:hover {
    color: var(--color-link);
  }

  .featured-excerpt {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0 0 32px;
    max-width: 880px;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
    flex-wrap: wrap;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-link) 0%, var(--c-violet) 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .author-role {
    font-size: 12px;
    color: var(--color-mute);
  }

  .featured-action {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .featured-date {
    font-size: 13px;
    color: var(--color-mute);
  }

  /* Articles Grid */
  .articles-section {
    margin-bottom: 64px;
  }

  .section-heading {
    margin: 0 0 28px;
    color: var(--color-ink);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  .post-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .post-read-time {
    color: var(--color-mute);
  }

  .post-card-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
  }

  .post-title-link {
    color: var(--color-ink);
    transition: color 0.15s ease;
  }

  .post-title-link:hover {
    color: var(--color-link);
  }

  .post-card-excerpt {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-body);
    margin: 0 0 16px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .post-tag {
    font-size: 12px;
    color: var(--color-mute);
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--color-hairline);
  }

  .post-author-snippet {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .author-avatar-sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-cyan) 0%, var(--c-link) 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
  }

  .post-author-details {
    display: flex;
    flex-direction: column;
  }

  .post-author-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
  }

  .post-date {
    font-size: 12px;
    color: var(--color-mute);
  }

  .post-read-link {
    color: var(--color-mute);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .post-card:hover .post-read-link {
    color: var(--color-link);
    transform: translateX(3px);
  }

  .no-results {
    text-align: center;
    padding: 48px;
    color: var(--color-mute);
  }

  /* Tools CTA */
  .tools-cta-box {
    padding: 40px;
    margin-top: 32px;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .cta-text {
    max-width: 600px;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .featured-card {
      padding: 24px;
    }

    .featured-title {
      font-size: 24px;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .cta-actions .btn {
      width: 100%;
    }

    .search-box {
      width: 100%;
    }
  }
</style>

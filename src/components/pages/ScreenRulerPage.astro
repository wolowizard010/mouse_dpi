---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import ScreenRulerComponent from "../ScreenRuler.astro";
import { useTranslations } from "../../i18n/utils";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<Layout
  title={t("screenRuler.metaTitle")}
  description={t("screenRuler.metaDesc")}
>
  <Navbar />

  <main class="ruler-page">
    <div class="container">
      <div class="page-header">
        <span class="caption-mono" style="color: var(--color-mute);">{t("nav.screenRuler")}</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">{t("screenRuler.title")}</h1>
        <p class="body-lg" style="color: var(--color-body); margin: 8px 0 0; max-width: 560px;">
          {t("screenRuler.subtitle")}
        </p>
      </div>

      <ScreenRulerComponent />

      <!-- Info section -->
      <div class="info-section" style="margin-top: 64px;">
        <div class="section-header">
          <span class="caption-mono" style="color: var(--color-mute);">{t("footer.about")}</span>
          <h2 class="display-md" style="margin: 8px 0 0;">{t("screenRuler.aboutTitle")}</h2>
        </div>

        <div style="margin-top: 32px;">
          <div class="card info-card" style="max-width: 600px;">
            <p class="body-md" style="color: var(--color-body); margin: 0;">
              {t("screenRuler.aboutDesc")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .ruler-page {
    padding: 48px 0 0;
  }

  .page-header {
    margin-bottom: 40px;
  }

  .info-card {
    padding: 32px;
  }

  @media (max-width: 768px) {
    .ruler-page {
      padding: 32px 0 0;
    }
  }
</style>

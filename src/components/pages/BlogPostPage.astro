---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const lang = Astro.currentLocale || 'en';
const siteUrl = Astro.site || new URL("https://mymousedpi.com");
const canonicalUrl = new URL(getRelativeLocaleUrl(lang, `blog/${post.id}`), siteUrl).href;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
}

// Filter headings for TOC (h2 and h3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// JSON-LD Structured Data
const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "jobTitle": post.data.authorRole,
  },
  "publisher": {
    "@type": "Organization",
    "name": "My Mouse DPI",
    "url": "https://mymousedpi.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mymousedpi.com/logo-light.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": new URL(getRelativeLocaleUrl(lang, ""), siteUrl).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": new URL(getRelativeLocaleUrl(lang, "blog"), siteUrl).href
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": canonicalUrl
    }
  ]
};
---

<Layout
  title={`${post.data.title} — My Mouse DPI`}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
>
  <!-- Inject Rich Article JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="reading-progress"></div>

  <Navbar />

  <main class="blog-post-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={getRelativeLocaleUrl(lang, "")}>Home</a></li>
          <li><span class="bc-sep">/</span></li>
          <li><a href={getRelativeLocaleUrl(lang, "blog")}>Blog</a></li>
          <li><span class="bc-sep">/</span></li>
          <li aria-current="page"><span class="bc-current">{post.data.title}</span></li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="post-header animate-fade-in">
        <div class="header-badges">
          <span class="badge category-pill">{post.data.category}</span>
          <span class="caption-mono read-time">{post.data.readTime}</span>
        </div>

        <h1 class="post-title display-xl">
          {post.data.title}
        </h1>

        <p class="post-description body-lg">
          {post.data.description}
        </p>

        <div class="post-byline">
          <div class="byline-author">
            <div class="author-avatar" aria-hidden="true">
              {post.data.author.split(' ').map((n: string) => n[0]).join('')}
            </div>
            <div class="byline-text">
              <span class="byline-name">{post.data.author}</span>
              <span class="byline-role">{post.data.authorRole}</span>
            </div>
          </div>

          <div class="byline-meta">
            <div class="date-item">
              <span class="date-label">Published</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            {post.data.updatedDate && (
              <div class="date-item">
                <span class="date-label">Updated</span>
                <time datetime={post.data.updatedDate.toISOString()}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </div>
            )}
          </div>
        </div>
      </header>

      <!-- Post Main Content Area (Article + Sticky Sidebar) -->
      <div class="post-layout">
        <!-- Article Content -->
        <article class="post-content">
          <!-- Mobile In-page Table of Contents / Index -->
          {tocHeadings.length > 0 && (
            <details class="mobile-toc card-soft">
              <summary class="mobile-toc-summary">
                <span class="mobile-toc-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                  </svg>
                  <span>Table of Contents / Index</span>
                </span>
                <svg class="mobile-toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <ul class="mobile-toc-list">
                {tocHeadings.map((heading) => (
                  <li class:list={[`mobile-toc-item toc-depth-${heading.depth}`]}>
                    <a href={`#${heading.slug}`} class="mobile-toc-link">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}

          <div class="blog-prose">
            <Content />
          </div>

          <!-- Post Tags -->
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-footer-tags">
              <span class="tags-label">Tagged in:</span>
              <div class="tags-list">
                {post.data.tags.map((tag: string) => (
                  <span class="badge tag-badge">#{tag}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Author Bio Box (E-E-A-T Credibility) -->
          <div class="author-bio-card card">
            <div class="bio-avatar">
              {post.data.author.split(' ').map((n: string) => n[0]).join('')}
            </div>
            <div class="bio-content">
              <div class="bio-header">
                <span class="bio-written">Written by</span>
                <h3 class="bio-name">{post.data.author}</h3>
                <span class="bio-role">{post.data.authorRole}</span>
              </div>
              <p class="bio-text body-sm">
                {post.data.authorBio || `${post.data.author} is a hardware and gaming peripherals specialist with extensive hands-on experience evaluating optical sensors, mouse ergonomics, and competitive input performance.`}
              </p>
            </div>
          </div>

          <!-- Bottom Tool Callout -->
          <div class="post-bottom-cta card-soft">
            <div class="bottom-cta-text">
              <h3 class="display-sm" style="margin: 0 0 8px;">Ready to test your real mouse DPI?</h3>
              <p class="body-sm" style="color: var(--color-body); margin: 0;">
                Find out if your mouse sensor suffers from deviation using our free web analyzer.
              </p>
            </div>
            <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary btn-sm">
              Test DPI Now
            </a>
          </div>

          <!-- Back to Blog Link -->
          <div class="back-to-blog">
            <a href={getRelativeLocaleUrl(lang, "blog")} class="back-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Back to all guides & articles</span>
            </a>
          </div>
        </article>

        <!-- Sidebar (Sticky Desktop) -->
        <aside class="post-sidebar">
          <div class="sticky-sidebar-inner">
            <!-- Share widget -->
            <div class="sidebar-widget card share-widget">
              <h4 class="sidebar-widget-title caption-mono">Share Guide</h4>
              <div class="share-buttons">
                <button id="copy-link-btn" class="share-btn" title="Copy article link" aria-label="Copy article link">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="copy-btn-text">Copy Link</span>
                </button>

                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonicalUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn"
                  title="Share on X / Twitter"
                  aria-label="Share on X"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  <span>Post</span>
                </a>

                <a
                  href={`https://www.reddit.com/submit?url=${encodeURIComponent(canonicalUrl)}&title=${encodeURIComponent(post.data.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn"
                  title="Share on Reddit"
                  aria-label="Share on Reddit"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.703zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.688-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
                  </svg>
                  <span>Reddit</span>
                </a>
              </div>
            </div>

            <!-- Table of Contents -->
            {tocHeadings.length > 0 && (
              <div class="sidebar-widget card toc-widget">
                <h4 class="sidebar-widget-title caption-mono">Table of Contents</h4>
                <nav class="toc-list" aria-label="Table of contents">
                  <ul>
                    {tocHeadings.map((heading) => (
                      <li class:list={[`toc-item toc-depth-${heading.depth}`]}>
                        <a href={`#${heading.slug}`} class="toc-link">
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )}

            <!-- Quick Tool Widget -->
            <div class="sidebar-widget card-soft tools-widget">
              <span class="caption-mono" style="color: var(--color-link);">Free Online Tool</span>
              <h4 class="tools-widget-title">Check Your Mouse DPI</h4>
              <p class="body-sm" style="color: var(--color-body); margin: 0 0 14px;">
                Calibrate your display and measure your true optical sensitivity in your browser.
              </p>
              <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary btn-sm" style="width: 100%;">
                Open Analyzer
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Reading progress bar
    const progressBar = document.getElementById('reading-progress-bar');
    window.addEventListener('scroll', () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPos = window.scrollY;
      if (progressBar && docHeight > 0) {
        const progress = (scrollPos / docHeight) * 100;
        progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
      }
    }, { passive: true });

    // Copy link button
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-btn-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy Link';
          }, 2000);
        } catch (err) {
          copyText.textContent = 'Copied!';
        }
      });
    }

    // TOC Active State Highlighting
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (id) {
            document.querySelectorAll('.toc-link').forEach((link) => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${id}`) {
                link.classList.add('active');
              }
            });
          }
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    document.querySelectorAll('.blog-prose h2, .blog-prose h3').forEach((heading) => {
      observer.observe(heading);
    });
  });
</script>

<style>
  /* Progress Bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--c-link), var(--c-cyan));
    z-index: 9999;
    width: 0%;
    transition: width 0.1s ease-out;
  }

  .blog-post-page {
    padding: 24px 0 64px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    margin-bottom: 32px;
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: var(--color-mute);
  }

  .breadcrumbs a {
    color: var(--color-mute);
    transition: color 0.15s ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-ink);
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: var(--color-ink);
    font-weight: 500;
    white-space: normal;
    word-break: break-word;
    display: inline;
  }

  /* Post Header */
  .post-header {
    max-width: 820px;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .category-pill {
    background: var(--color-canvas);
    color: var(--color-ink);
    font-weight: 500;
  }

  .read-time {
    color: var(--color-mute);
  }

  .post-title {
    margin: 0 0 20px;
    color: var(--color-ink);
    letter-spacing: -0.025em;
  }

  .post-description {
    color: var(--color-mute);
    margin: 0 0 28px;
    line-height: 1.6;
  }

  .post-byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
  }

  .byline-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-link) 0%, var(--c-violet) 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 600;
  }

  .byline-text {
    display: flex;
    flex-direction: column;
  }

  .byline-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .byline-role {
    font-size: 13px;
    color: var(--color-mute);
  }

  .byline-meta {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .date-item {
    display: flex;
    flex-direction: column;
    font-size: 13px;
  }

  .date-label {
    font-size: 11px;
    color: var(--color-mute);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .date-item time {
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Two Column Layout */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }

  .post-content {
    max-width: 760px;
    min-width: 0;
  }

  /* Tags */
  .post-footer-tags {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 40px 0 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
    flex-wrap: wrap;
  }

  .tags-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-mute);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-badge {
    background: var(--color-canvas);
    color: var(--color-body);
    font-size: 12px;
  }

  /* Author Bio Card */
  .author-bio-card {
    display: flex;
    gap: 20px;
    padding: 24px;
    margin: 32px 0;
    align-items: flex-start;
  }

  .bio-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-link) 0%, var(--c-violet) 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .bio-content {
    flex-grow: 1;
  }

  .bio-written {
    font-size: 11px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--color-mute);
  }

  .bio-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 2px 0 2px;
  }

  .bio-role {
    font-size: 12px;
    color: var(--color-link);
    display: block;
    margin-bottom: 8px;
  }

  .bio-text {
    color: var(--color-body);
    margin: 0;
    line-height: 1.55;
  }

  /* Bottom CTA */
  .post-bottom-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    margin: 32px 0;
  }

  .back-to-blog {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-body);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-link);
  }

  /* Sticky Sidebar */
  .post-sidebar {
    position: relative;
  }

  .sticky-sidebar-inner {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-widget {
    padding: 20px;
  }

  .sidebar-widget-title {
    margin: 0 0 14px;
    color: var(--color-mute);
    font-size: 11px;
  }

  /* Share buttons */
  .share-buttons {
    display: flex;
    gap: 8px;
  }

  .share-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    color: var(--color-body);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .share-btn:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas);
  }

  /* TOC */
  /* TOC / Index */
  .toc-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 440px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .toc-item {
    font-size: 13px;
    line-height: 1.45;
  }

  .toc-depth-3 {
    padding-left: 14px;
    font-size: 12px;
  }

  .toc-link {
    color: var(--color-body);
    text-decoration: none;
    transition: all 0.15s ease;
    display: block;
    white-space: normal; /* Allows title to wrap onto the next line naturally */
    word-break: break-word;
    overflow-wrap: break-word;
    padding: 5px 8px;
    border-radius: var(--radius-xs);

---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<Layout
  title={t("howItWorks.metaTitle")}
  description={t("howItWorks.metaDesc")}
>
  <Navbar />

  <main class="content-page">
    <div class="container">
      <div class="content-layout">
        <!-- Main Content -->
        <article class="content-main">
          <div class="page-header">
            <span class="caption-mono" style="color: var(--color-mute);">{t("howItWorks.sidebarTitle")}</span>
            <h1 class="display-lg" style="margin: 8px 0 0;">{t("howItWorks.title")}</h1>
            <p class="body-lg" style="color: var(--color-body); margin: 12px 0 0;">
              {t("howItWorks.subtitle")}
            </p>
          </div>

          <!-- What is DPI -->
          <section class="content-section">
            <h2 class="display-md">{t("howItWorks.q1Title")}</h2>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.q1Desc")}
            </p>
            <div class="info-callout card-soft">
              <div class="callout-header">
                <span class="caption-mono" style="color: var(--color-link);">{t("howItWorks.exampleTitle")}</span>
              </div>
              <p class="body-sm" style="color: var(--color-body); margin: 8px 0 0;" set:html={t("howItWorks.exampleDesc")}>
              </p>
            </div>
          </section>

          <!-- DPI vs Sensitivity -->
          <section class="content-section">
            <h2 class="display-md">{t("howItWorks.q2Title")}</h2>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.q2Desc")}
            </p>
            <div class="comparison-table card">
              <table>
                <thead>
                  <tr>
                    <th class="caption-mono">{t("howItWorks.tableAspect")}</th>
                    <th class="caption-mono">{t("howItWorks.tableDpi")}</th>
                    <th class="caption-mono">{t("howItWorks.tableSens")}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="body-sm" style="font-weight: 500;">{t("howItWorks.tableRowType")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowTypeDpi")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowTypeSens")}</td>
                  </tr>
                  <tr>
                    <td class="body-sm" style="font-weight: 500;">{t("howItWorks.tableRowRes")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowResDpi")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowResSens")}</td>
                  </tr>
                  <tr>
                    <td class="body-sm" style="font-weight: 500;">{t("howItWorks.tableRowPrec")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowPrecDpi")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowPrecSens")}</td>
                  </tr>
                  <tr>
                    <td class="body-sm" style="font-weight: 500;">{t("howItWorks.tableRowQual")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowQualDpi")}</td>
                    <td class="body-sm">{t("howItWorks.tableRowQualSens")}</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.tableFooter")}
            </p>
          </section>

          <!-- How We Measure -->
          <section class="content-section">
            <h2 class="display-md">{t("howItWorks.q3Title")}</h2>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.q3Desc")}
            </p>

            <div class="steps-list">
              <div class="step-item">
                <div class="step-marker">
                  <span class="code-text">1</span>
                </div>
                <div>
                  <h4 class="body-md" style="font-weight: 500; margin: 0 0 4px;">{t("howItWorks.step1Title")}</h4>
                  <p class="body-sm" style="color: var(--color-body); margin: 0;">
                    {t("howItWorks.step1Desc")}
                  </p>
                </div>
              </div>
              <div class="step-item">
                <div class="step-marker">
                  <span class="code-text">2</span>
                </div>
                <div>
                  <h4 class="body-md" style="font-weight: 500; margin: 0 0 4px;">{t("howItWorks.step2Title")}</h4>
                  <p class="body-sm" style="color: var(--color-body); margin: 0;">
                    {t("howItWorks.step2Desc")}
                  </p>
                </div>
              </div>
              <div class="step-item">
                <div class="step-marker">
                  <span class="code-text">3</span>
                </div>
                <div>
                  <h4 class="body-md" style="font-weight: 500; margin: 0 0 4px;">{t("howItWorks.step3Title")}</h4>
                  <p class="body-sm" style="color: var(--color-body); margin: 0;">
                    {t("howItWorks.step3Desc")}
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Why Pointer Lock -->
          <section class="content-section">
            <h2 class="display-md">{t("howItWorks.q4Title")}</h2>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.q4Desc")}
            </p>
            <ul class="body-md content-list" style="color: var(--color-body);">
              <li><strong>{t("howItWorks.q4Bullet1").split(':')[0]}:</strong>{t("howItWorks.q4Bullet1").split(':').slice(1).join(':')}</li>
              <li><strong>{t("howItWorks.q4Bullet2").split(':')[0]}:</strong>{t("howItWorks.q4Bullet2").split(':').slice(1).join(':')}</li>
              <li><strong>{t("howItWorks.q4Bullet3").split(':')[0]}:</strong>{t("howItWorks.q4Bullet3").split(':').slice(1).join(':')}</li>
              <li><strong>{t("howItWorks.q4Bullet4").split(':')[0]}:</strong>{t("howItWorks.q4Bullet4").split(':').slice(1).join(':')}</li>
            </ul>
            <p class="body-md" style="color: var(--color-body);">
              {t("howItWorks.q4Desc2")}
            </p>
            <div class="info-callout card-soft">
              <div class="callout-header">
                <span class="caption-mono" style="color: var(--color-warning);">{t("howItWorks.q4Important")}</span>
              </div>
              <p class="body-sm" style="color: var(--color-body); margin: 8px 0 0;" set:html={t("howItWorks.q4ImportantDesc")}>
              </p>
            </div>
          </section>

          <!-- Common DPI Values -->
          <section class="content-section">
            <h2 class="display-md">{t("howItWorks.q5Title")}</h2>
            <div class="comparison-table card">
              <table>
                <thead>
                  <tr>
                    <th class="caption-mono">{t("howItWorks.tableColDpi")}</th>
                    <th class="caption-mono">{t("howItWorks.tableColUse")}</th>
                    <th class="caption-mono">{t("howItWorks.tableColCommon")}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="code-text">400</td>
                    <td class="body-sm">{t("howItWorks.q5Row1Use")}</td>
                    <td class="body-sm">{t("howItWorks.q5Row1Common")}</td>
                  </tr>
                  <tr>
                    <td class="code-text">800</td>
                    <td class="body-sm">{t("howItWorks.q5Row2Use")}</td>
                    <td class="body-sm">{t("howItWorks.q5Row2Common")}</td>
                  </tr>
                  <tr>
                    <td class="code-text">1600</td>
                    <td class="body-sm">{t("howItWorks.q5Row3Use")}</td>
                    <td class="body-sm">{t("howItWorks.q5Row3Common")}</td>
                  </tr>
                  <tr>
                    <td class="code-text">3200+</td>
                    <td class="body-sm">{t("howItWorks.q5Row4Use")}</td>
                    <td class="body-sm">{t("howItWorks.q5Row4Common")}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- CTA -->
          <section class="content-section" style="text-align: center; padding: 48px 0;">
            <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary">
              {t("howItWorks.ctaBtn")}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </section>
        </article>

        <!-- Sidebar -->
        <aside class="content-sidebar">
          <div class="sidebar-card card-soft">
            <h4 class="caption-mono" style="margin: 0 0 16px; color: var(--color-mute);">{t("howItWorks.sidebarTitle")}</h4>
            <nav class="sidebar-nav">
              <a href="#" class="sidebar-link body-sm">{t("howItWorks.sidebarLink1")}</a>
              <a href="#" class="sidebar-link body-sm">{t("howItWorks.sidebarLink2")}</a>
              <a href="#" class="sidebar-link body-sm">{t("howItWorks.sidebarLink3")}</a>
              <a href="#" class="sidebar-link body-sm">{t("howItWorks.sidebarLink4")}</a>
              <a href="#" class="sidebar-link body-sm">{t("howItWorks.sidebarLink5")}</a>
            </nav>
          </div>

          <div class="sidebar-card card" style="margin-top: 16px;">
            <h4 class="body-sm" style="font-weight: 500; margin: 0 0 8px;">{t("howItWorks.sidebarCtaTitle")}</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0 0 16px;">
              {t("howItWorks.sidebarCtaDesc")}
            </p>
            <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary btn-sm" style="width: 100%;">
              {t("howItWorks.sidebarCtaBtn")}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .content-page {
    padding: 48px 0 0;
  }

  .page-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .content-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 48px;
    align-items: start;
  }

  .content-section {
    margin-bottom: 48px;
  }

  .content-section h2 {
    margin: 0 0 16px;
  }

  .content-section p {
    margin: 0 0 16px;
  }

  .content-list {
    padding-left: 24px;
    margin: 0 0 16px;
  }

  .content-list li {
    margin-bottom: 8px;
  }

  .info-callout {
    padding: 20px;
    margin: 20px 0;
  }

  .comparison-table {
    padding: 0;
    overflow: hidden;
    margin: 20px 0;
  }

  .comparison-table table {
    width: 100%;
    border-collapse: collapse;
  }

  .comparison-table th {
    text-align: left;
    padding: 12px 16px;
    background: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
  }

  .comparison-table td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 20px 0;
  }

  .step-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .step-marker {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--color-canvas-soft-2);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  /* Sidebar */
  .content-sidebar {
    position: sticky;
    top: 84px;
  }

  .sidebar-card {
    padding: 20px;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-link {
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 4px 0;
  }

  .sidebar-link:hover {
    color: var(--color-ink);
  }

  @media (max-width: 768px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    .content-sidebar {
      position: static;
      order: -1;
    }
  }
</style>

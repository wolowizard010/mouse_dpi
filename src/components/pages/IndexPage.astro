---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);

const faqs = t("index.faq") as Array<{ question: string; answer: string }>;
---

<Layout
  title={t("metadata.title")}
  description={t("metadata.description")}
  image="/og-image.png"
>
  <Navbar />

  <!-- Hero Band -->
  <section class="hero">
    <div class="hero-gradient mesh-gradient"></div>
    <div class="container hero-content">
      <h1 class="display-xl hero-title animate-fade-in delay-1" set:html={t("index.heroTitle")}>
      </h1>
      <p class="body-lg hero-subtitle animate-fade-in delay-2">
        {t("index.heroSubtitle")}
      </p>
      <div class="hero-cta animate-fade-in delay-3">
        <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-primary" id="hero-cta-primary">
          {t("index.testYourDpi")}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={getRelativeLocaleUrl(lang, "screen-ruler")} class="btn btn-secondary" id="hero-cta-secondary">
          {t("index.screenRuler")}
        </a>
      </div>
      <div class="hero-links animate-fade-in delay-3">
        <a href={getRelativeLocaleUrl(lang, "about")} class="hero-link">{t("index.about")}</a>
        <span class="hero-link-separator">•</span>
        <a href={getRelativeLocaleUrl(lang, "contact")} class="hero-link">{t("index.contact")}</a>
        <span class="hero-link-separator">•</span>
        <a href={getRelativeLocaleUrl(lang, "terms-and-conditions")} class="hero-link">{t("index.terms")}</a>
        <span class="hero-link-separator">•</span>
        <a href={getRelativeLocaleUrl(lang, "privacy-policy")} class="hero-link">{t("index.privacy")}</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how-section">
    <div class="container">
      <div class="section-header">
        <span class="caption-mono" style="color: var(--color-mute);">{t("index.stepsTitle")}</span>
        <h2 class="display-lg" style="margin: 8px 0 0;">{t("index.stepsSubtitle")}</h2>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number caption-mono">01</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">{t("index.step1Title")}</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            {t("index.step1Desc")}
          </p>
        </div>
        <div class="step-divider">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-hairline)" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number caption-mono">02</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">{t("index.step2Title")}</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            {t("index.step2Desc")}
          </p>
        </div>
        <div class="step-divider">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-hairline)" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number caption-mono">03</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">{t("index.step3Title")}</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            {t("index.step3Desc")}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="seo-article container">
    <div class="article-content">
      <h2>{t("index.articleTitle1")}</h2>
      <p set:html={t("index.articleContent1")}></p>

      <h2>{t("index.articleTitle2")}</h2>
      <p set:html={t("index.articleContent2")}></p>

      <h2>{t("index.articleTitle3")}</h2>
      <p set:html={t("index.articleContent3")}></p>

      <h2>{t("index.articleTitle4")}</h2>
      <p set:html={t("index.articleContent4")}></p>

      <h2>{t("index.articleTitle5")}</h2>
      <p set:html={t("index.articleContent5")}></p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="faq-section container">
    <div class="section-header" style="text-align: center; margin-bottom: 48px;">
      <h2 class="display-lg">{t("index.faqTitle")}</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <div class="faq-item card" id={`faq-${index}`}>
          <button class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
            <span class="body-md" style="font-weight: 500;">{faq.question}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-answer" id={`faq-answer-${index}`}>
            <p class="body-md" style="color: var(--color-body); margin: 0;">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- JSON-LD for FAQ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    })} />
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="container" style="text-align: center;">
      <h2 class="display-lg" style="color: var(--color-on-primary); margin: 0 0 16px;">{t("index.ctaTitle")}</h2>
      <p class="body-lg" style="color: var(--color-hairline-strong); margin: 0 0 32px;">
        {t("index.ctaSubtitle")}
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href={getRelativeLocaleUrl(lang, "dpi-analyzer")} class="btn btn-secondary" style="border-color: rgba(255,255,255,0.2);">
          {t("index.ctaBtn")}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 96px 0 80px;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    margin: 0 0 20px;
    max-width: 700px;
  }

  .hero-subtitle {
    margin: 0 0 36px;
    color: var(--color-body);
    max-width: 560px;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 48px;
  }

  .hero-links {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-link {
    color: var(--color-mute);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .hero-link:hover {
    color: var(--color-link);
  }

  .hero-link-separator {
    color: var(--color-hairline-strong);
    font-size: 14px;
  }

  /* How it works */
  .how-section {
    padding: 96px 0;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .steps-grid {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .step-card {
    flex: 1;
    padding: 24px;
  }

  .step-number {
    color: var(--color-link);
    font-size: 14px;
    letter-spacing: 1px;
  }

  .step-divider {
    display: flex;
    align-items: center;
    padding-top: 32px;
    flex-shrink: 0;
  }

  /* CTA Band */
  .cta-band {
    padding: 96px 0;
    background: var(--color-ink);
  }

  /* FAQ Section */
  .faq-section {
    padding: 64px 0 96px;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    overflow: hidden;
    padding: 0;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 20px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
    font-family: var(--font-sans);
    color: var(--color-ink);
    transition: background 0.15s ease;
  }

  .faq-question:hover {
    background: var(--color-canvas-soft);
  }

  .faq-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    color: var(--color-mute);
  }

  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.3s ease, visibility 0s 0.3s;
    padding: 0 24px;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.3s ease, visibility 0s 0s;
    padding: 0 24px 20px;
  }

  /* SEO Article */
  .seo-article {
    padding: 64px 0 96px;
    max-width: 800px;
    margin: 0 auto;
  }

  .article-content h2 {
    font-size: 28px;
    margin: 48px 0 16px;
    color: var(--color-on-canvas);
  }

  .article-content h2:first-child {
    margin-top: 0;
  }

  .article-content p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
    margin-bottom: 24px;
  }

  .article-content strong {
    color: var(--color-on-canvas);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 64px 0 48px;
    }

    .hero-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -1.6px;
    }

    .steps-grid {
      flex-direction: column;
    }

    .step-divider {
      transform: rotate(90deg);
      padding-top: 0;
      padding: 8px 0;
    }
  }
</style>

<script>
  document.querySelectorAll(".faq-question").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      if (!item) return;

      const wasOpen = item.classList.contains("open");

      // Close all
      document.querySelectorAll(".faq-item").forEach((i) => i.classList.remove("open"));

      // Toggle current
      if (!wasOpen) {
        item.classList.add("open");
      }
    });
  });
</script>

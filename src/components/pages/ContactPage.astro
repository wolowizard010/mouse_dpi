---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations } from "../../i18n/utils";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<Layout
  title={t("contact.metaTitle")}
  description={t("contact.metaDesc")}
>
  <Navbar />
  <main class="page-container container">
    <div style="max-width: 720px;">
      <div style="margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--color-hairline);">
        <span class="caption-mono" style="color: var(--color-mute);">{t("footer.contact")}</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">{t("contact.title")}</h1>
      </div>
      <div class="content">
        <p class="body-lg" style="color: var(--color-body); margin-bottom: 24px;">
          {t("contact.desc")}
        </p>

        <form 
          class="contact-form" 
          action="#" 
          method="POST" 
          data-success-msg={t("contact.successMessage")}
          onsubmit="event.preventDefault(); alert(this.getAttribute('data-success-msg'));"
        >
          <div class="form-group">
            <label for="name" class="body-md" style="font-weight: 500;">{t("contact.nameLabel")}</label>
            <input type="text" id="name" name="name" class="form-input" placeholder={t("contact.namePlaceholder")} required />
          </div>
          <div class="form-group">
            <label for="email" class="body-md" style="font-weight: 500;">{t("contact.emailLabel")}</label>
            <input type="email" id="email" name="email" class="form-input" placeholder={t("contact.emailPlaceholder")} required />
          </div>
          <div class="form-group">
            <label for="message" class="body-md" style="font-weight: 500;">{t("contact.messageLabel")}</label>
            <textarea id="message" name="message" rows="5" class="form-input" placeholder={t("contact.messagePlaceholder")} required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: 16px; align-self: flex-start;">{t("contact.submitBtn")}</button>
        </form>


      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 48px 0 0;
    margin-bottom: 64px;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-input {
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
    color: var(--color-ink);
    font-family: inherit;
    font-size: 16px;
    transition: border-color 0.15s ease;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--color-link);
  }
  .form-input::placeholder {
    color: var(--color-mute);
  }
</style>

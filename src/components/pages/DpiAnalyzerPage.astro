---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import DpiTool from "../DpiTool.astro";
import { useTranslations } from "../../i18n/utils";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<Layout
  title={t("dpiAnalyzer.metaTitle")}
  description={t("dpiAnalyzer.metaDesc")}
>
  <Navbar />

  <main class="analyzer-page">
    <div class="container">
      <!-- Page Header -->
      <div class="page-header">
        <span class="caption-mono" style="color: var(--color-mute);">{t("nav.dpiAnalyzer")}</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">{t("dpiAnalyzer.title")}</h1>
        <p class="body-lg" style="color: var(--color-body); margin: 8px 0 0; max-width: 520px;">
          {t("dpiAnalyzer.subtitle")}
        </p>
      </div>

      <!-- DPI Tool -->
      <DpiTool />

      <!-- Tips -->
      <div class="tips-section" style="margin-top: 64px;">
        <div class="section-header">
          <span class="caption-mono" style="color: var(--color-mute);">{t("dpiAnalyzer.tipsTitle")}</span>
          <h2 class="display-md" style="margin: 8px 0 0;">{t("dpiAnalyzer.tipsSubtitle")}</h2>
        </div>
        <div class="tips-grid" style="margin-top: 32px;">
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">{t("dpiAnalyzer.tip1Title")}</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              {t("dpiAnalyzer.tip1Desc")}
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">{t("dpiAnalyzer.tip2Title")}</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              {t("dpiAnalyzer.tip2Desc")}
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">{t("dpiAnalyzer.tip3Title")}</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              {t("dpiAnalyzer.tip3Desc")}
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">{t("dpiAnalyzer.tip4Title")}</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              {t("dpiAnalyzer.tip4Desc")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .analyzer-page {
    padding: 48px 0 0;
  }

  .page-header {
    margin-bottom: 40px;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .tip-card {
    padding: 24px;
  }

  @media (max-width: 768px) {
    .analyzer-page {
      padding: 32px 0 0;
    }

    .tips-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

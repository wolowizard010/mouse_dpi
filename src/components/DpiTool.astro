---
// DpiTool.astro — Core DPI measurement engine
// Uses Pointer Lock API for accurate, unaccelerated mouse movement tracking
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<section class="dpi-tool" id="dpi-tool" data-translations={JSON.stringify(t("dpiToolStrings"))} data-lang={lang}>
  <div class="tool-layout">
    <!-- Settings Panel -->
    <div class="tool-settings card" id="settings-panel">
      <h3 class="display-sm" style="margin: 0 0 20px;">{t("dpiToolStrings.settings")}</h3>

      <div class="setting-group">
        <label class="setting-label body-sm">{t("dpiToolStrings.targetDistance")}</label>
        <div class="setting-row">
          <input
            type="number"
            class="input"
            id="target-distance"
            value="5"
            min="0.5"
            max="20"
            step="0.5"
          />
          <div class="unit-toggle" id="unit-toggle">
            <button class="unit-btn active" data-unit="inch" id="unit-inch">{t("dpiToolStrings.inch")}</button>
            <button class="unit-btn" data-unit="cm" id="unit-cm">{t("dpiToolStrings.cm")}</button>
          </div>
        </div>
      </div>

      <div class="setting-group">
        <label class="setting-label body-sm">
          {t("dpiToolStrings.configuredDpi")}
          <span class="optional">
            ({lang === 'zh' ? '可选' : (lang === 'ru' ? 'опционально' : (lang === 'de' ? 'optional' : (lang === 'fr' ? 'optionnel' : (lang === 'es' ? 'opcional' : (lang === 'it' ? 'opzionale' : (lang === 'nl' ? 'optioneel' : (lang === 'pl' ? 'opcjonalnie' : (lang === 'pt' ? 'opcional' : (lang === 'sv' ? 'valfritt' : (lang === 'da' ? 'valgfrit' : (lang === 'no' ? 'valgfritt' : (lang === 'fi' ? 'valinnainen' : 'optional'))))))))))))})
          </span>
        </label>
        <input
          type="number"
          class="input"
          id="configured-dpi"
          placeholder={t("dpiToolStrings.configuredDpiPlaceholder")}
          min="100"
          max="32000"
          step="50"
        />
      </div>

      <div class="setting-group" style="background: var(--color-canvas-soft); padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline);">
        <div class="setting-row" style="align-items: center; cursor: pointer;">
          <input type="checkbox" id="virtual-ruler-cb" style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--color-link);" />
          <label for="virtual-ruler-cb" class="body-sm" style="margin-left: 8px; cursor: pointer; font-weight: 500;">{t("dpiToolStrings.useVirtualRuler")}</label>
        </div>
      </div>

      <div id="calibration-settings" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-hairline); transition: background 0.3s ease; border-radius: var(--radius-sm); padding-left: 8px; padding-right: 8px;">
        <h4 class="body-sm" style="font-weight: 500; margin: 0 0 12px;">{t("dpiToolStrings.screenCalibration")}</h4>
        <button class="btn btn-secondary btn-sm" id="open-calibration-btn" style="width: 100%;">{t("dpiToolStrings.calibrateScreen")}</button>
        <div class="body-sm" id="calibration-status-text" style="color: var(--color-mute); margin-top: 8px; text-align: center;">{t("dpiToolStrings.notCalibrated")}</div>
      </div>

      <div class="setting-group">
        <label class="setting-label body-sm">{t("dpiToolStrings.axis")}</label>
        <div class="unit-toggle" id="axis-toggle">
          <button class="unit-btn active" data-axis="x" id="axis-x">{t("dpiToolStrings.horizontal")}</button>
          <button class="unit-btn" data-axis="y" id="axis-y">{t("dpiToolStrings.vertical")}</button>
        </div>
      </div>

      <button class="btn btn-secondary btn-sm" id="reset-btn" style="width: 100%; margin-top: 12px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
        {t("dpiToolStrings.reset")}
      </button>

      <!-- Instructions -->
      <div class="instructions card-soft" style="margin-top: 20px; padding: 16px;">
        <p class="caption-mono" style="margin: 0 0 8px; color: var(--color-mute);">{t("dpiToolStrings.howToTest")}</p>
        <ol class="instruction-list body-sm">
          <li>{t("dpiToolStrings.testStep1")}</li>
          <li>{t("dpiToolStrings.testStep2")}</li>
          <li>{t("dpiToolStrings.testStep3")}</li>
          <li>{t("dpiToolStrings.testStep4")}</li>
        </ol>
      </div>
    </div>

    <!-- Test Area -->
    <div class="tool-test-wrapper">
      <div class="test-area card" id="test-area">
        <div class="test-area-inner" id="test-area-inner">
          <!-- Crosshair -->
          <div class="crosshair" id="crosshair">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="var(--color-hairline)" stroke-width="1" stroke-dasharray="4 4"/>
              <line x1="20" y1="4" x2="20" y2="16" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="20" y1="24" x2="20" y2="36" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4" y1="20" x2="16" y2="20" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="24" y1="20" x2="36" y2="20" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="20" cy="20" r="2" fill="var(--color-link)"/>
            </svg>
          </div>

          <!-- State overlay -->
          <div class="test-overlay" id="test-overlay">
            <div class="test-prompt" id="test-prompt">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 3l14 9-14 9V3z"></path>
              </svg>
              <span class="body-md" id="test-prompt-title" style="font-weight: 500;">{t("dpiToolStrings.clickToStart")}</span>
              <span class="body-sm" id="test-prompt-desc" style="color: var(--color-mute);">{t("dpiToolStrings.cursorLockedDesc")}</span>
            </div>
          </div>

          <!-- Active state info -->
          <div class="test-active-info" id="test-active-info" style="display: none;">
            <div class="live-counter">
              <span class="caption-mono" style="color: var(--color-mute);">{t("dpiToolStrings.pixelsMoved")}</span>
              <span class="live-pixels display-lg" id="live-pixels">0</span>
            </div>
            <div class="live-direction" id="live-direction">
              <span class="caption-mono" id="direction-label" style="color: var(--color-mute);">{t("dpiToolStrings.moveMouseRight")}</span>
            </div>
            
            <div id="on-screen-ruler-wrapper" style="display: none; width: 100%; max-width: 800px; border-radius: var(--radius-sm); margin-top: 16px;">
              <canvas id="ruler-canvas" style="display: block; width: 100%; min-height: 80px;"></canvas>
            </div>
          </div>
        </div>

        <!-- Gradient border animation -->
        <div class="test-area-border" id="test-area-border"></div>
      </div>

      <!-- Real-time stats bar -->
      <div class="live-stats" id="live-stats">
        <div class="live-stat">
          <span class="caption-mono">{t("dpiToolStrings.pixelsLabel")}</span>
          <span class="stat-value code-text" id="stat-pixels">0</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">{t("dpiToolStrings.distanceLabel")}</span>
          <span class="stat-value code-text" id="stat-distance">0.00 in</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">{t("dpiToolStrings.dpiLabel")}</span>
          <span class="stat-value code-text" id="stat-dpi">—</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">{t("dpiToolStrings.statusLabel")}</span>
          <span class="stat-value stat-status code-text" id="stat-status">{t("dpiToolStrings.statusReady")}</span>
        </div>
      </div>
    </div>

    <!-- Results Panel -->
    <div class="tool-results card" id="results-panel">
      <h3 class="display-sm" style="margin: 0 0 20px;">{t("dpiToolStrings.results")}</h3>

      <!-- Main DPI result -->
      <div class="result-main" id="result-main">
        <span class="caption-mono" style="color: var(--color-mute);">{t("dpiToolStrings.measuredDpi")}</span>
        <span class="result-dpi display-xl" id="result-dpi">—</span>
      </div>

      <!-- Comparison -->
      <div class="result-comparison" id="result-comparison" style="display: none;">
        <div class="comparison-bar">
          <div class="comparison-configured">
            <span class="body-sm" style="font-weight: 500;">{t("dpiToolStrings.configured")}</span>
            <span class="code-text" id="comparison-configured-val">—</span>
          </div>
          <div class="comparison-vs body-sm" style="color: var(--color-mute);">{t("dpiToolStrings.vs")}</div>
          <div class="comparison-measured">
            <span class="body-sm" style="font-weight: 500;">{t("dpiToolStrings.measured")}</span>
            <span class="code-text" id="comparison-measured-val">—</span>
          </div>
        </div>
        <div class="comparison-diff" id="comparison-diff"></div>
      </div>

      <!-- Details -->
      <div class="result-details" id="result-details" style="display: none;">
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">{t("dpiToolStrings.detailPixels")}</span>
          <span class="code-text" id="detail-pixels">—</span>
        </div>
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">{t("dpiToolStrings.detailDistance")}</span>
          <span class="code-text" id="detail-distance">—</span>
        </div>
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">{t("dpiToolStrings.detailAxis")}</span>
          <span class="code-text" id="detail-axis">—</span>
        </div>
      </div>

      <!-- History -->
      <div class="result-history" id="result-history">
        <h4 class="caption-mono" style="margin: 24px 0 12px; color: var(--color-mute);">{t("dpiToolStrings.testHistory")}</h4>
        <div class="history-empty body-sm" id="history-empty" style="color: var(--color-mute);">
          {t("dpiToolStrings.noTests")}
        </div>
        <div class="history-list" id="history-list"></div>
      </div>
    </div>
  </div>

  <!-- Calibration Modal -->
  <div class="modal-overlay" id="calibration-modal" style="display: none;">
    <div class="modal-content card">
      <div class="modal-header">
        <h3 class="display-sm" style="margin: 0;">{t("dpiToolStrings.calibrateModalTitle")}</h3>
        <button class="icon-btn" id="close-calibration-btn" style="background: transparent; border: none; cursor: pointer; color: var(--color-body);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      
      <div class="modal-body" style="margin-top: 16px;">
        <p class="body-sm" style="margin: 0 0 16px; color: var(--color-body);">
          {t("dpiToolStrings.calibrateModalDesc")}
        </p>

        <div class="unit-toggle" id="calibration-mode-toggle" style="margin-bottom: 16px; display: flex; width: 100%;">
          <button class="unit-btn active" data-mode="preset" style="flex: 1; text-align: center;">{t("dpiToolStrings.presets")}</button>
          <button class="unit-btn" data-mode="manual" style="flex: 1; text-align: center;">{t("dpiToolStrings.manualEntry")}</button>
        </div>

        <div class="setting-group" id="preset-group">
          <label class="setting-label body-sm">{t("dpiToolStrings.selectMonitor")}</label>
          <select class="input" id="preset-select" style="width: 100%; cursor: pointer;">
            <!-- Options populated by JS -->
          </select>
        </div>

        <div id="manual-entry-section" style="display: none;">
          <div class="setting-group">
            <label class="setting-label body-sm">{t("dpiToolStrings.screenDiagonal")}</label>
            <input type="number" class="input" id="modal-screen-diagonal" placeholder="e.g. 24" min="5" max="100" step="0.1" />
          </div>
          <div class="setting-group">
            <label class="setting-label body-sm">{t("dpiToolStrings.resolution")}</label>
            <div style="display: flex; gap: 8px; align-items: center;">
              <input type="number" class="input" id="modal-screen-width" placeholder="1920" />
              <span class="body-sm" style="color: var(--color-mute);">×</span>
              <input type="number" class="input" id="modal-screen-height" placeholder="1080" />
            </div>
          </div>
        </div>

        <button class="btn btn-primary" id="apply-calibration-btn" style="width: 100%; margin-top: 16px;">{t("dpiToolStrings.applyCalibration")}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .dpi-tool {
    width: 100%;
  }

  .tool-layout {
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 20px;
    align-items: start;
  }

  /* Settings */
  .tool-settings {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .setting-group {
    margin-bottom: 16px;
  }

  .setting-label {
    display: block;
    color: var(--color-body);
    margin-bottom: 6px;
    font-weight: 500;
  }

  .optional {
    color: var(--color-mute);
    font-weight: 400;
  }

  .setting-row {
    display: flex;
    gap: 8px;
  }

  .setting-row .input {
    flex: 1;
  }

  .unit-toggle {
    display: flex;
    background: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
    padding: 2px;
    gap: 2px;
  }

  .unit-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 7px 14px;
    border: none;
    background: transparent;
    color: var(--color-body);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .unit-btn.active {
    background: var(--color-ink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  .instruction-list {
    margin: 0;
    padding-left: 18px;
    color: var(--color-body);
  }

  .instruction-list li {
    margin-bottom: 4px;
  }

  .instruction-list kbd {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    box-shadow: 0 1px 0 var(--color-hairline);
  }

  /* Test Area */
  .tool-test-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .test-area {
    position: relative;
    min-height: 420px;
    cursor: crosshair;
    overflow: hidden;
    padding: 0;
  }

  .test-area-inner {
    position: relative;
    width: 100%;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: 
      linear-gradient(var(--color-hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
  }

  .crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .test-area:hover .crosshair {
    opacity: 0.7;
  }

  .test-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .test-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--color-ink);
    background: var(--c-overlay);
    backdrop-filter: blur(8px);
    padding: 32px 48px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
  }

  .test-active-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 2;
    pointer-events: none;
  }

  .live-counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .live-pixels {
    color: var(--color-link);
    font-variant-numeric: tabular-nums;
  }

  .live-direction {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .test-area-border {
    position: absolute;
    inset: -2px;
    border-radius: var(--radius-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .test-area.active .test-area-border {
    opacity: 1;
    background: linear-gradient(135deg, 
      var(--color-grad-develop-start), 
      var(--color-grad-develop-end),
      var(--color-grad-preview-start),
      var(--color-grad-preview-end)
    );
    animation: border-rotate 4s linear infinite;
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 2px;
  }

  @keyframes border-rotate {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  .test-area.active {
    cursor: none;
  }

  .test-area.active .test-overlay {
    opacity: 0;
    pointer-events: none;
  }

  /* Live stats bar */
  .live-stats {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-radius: var(--radius-md);
    padding: 12px 20px;
    overflow-x: auto;
  }

  .live-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .live-stat .caption-mono {
    color: var(--color-hairline-strong);
    font-size: 10px;
  }

  .stat-value {
    color: var(--color-on-primary);
    font-variant-numeric: tabular-nums;
  }

  .stat-status {
    color: var(--color-cyan);
  }

  .live-stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 16px;
    flex-shrink: 0;
  }

  /* Results */
  .tool-results {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .result-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .result-dpi {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  .result-dpi.success {
    color: var(--color-success);
  }

  .result-comparison {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .comparison-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .comparison-configured,
  .comparison-measured {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: center;
  }

  .comparison-diff {
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-family: var(--font-mono);
    text-align: center;
  }

  .comparison-diff.match {
    background: rgba(0, 112, 243, 0.08);
    color: var(--color-link);
  }

  .comparison-diff.off {
    background: rgba(245, 166, 35, 0.08);
    color: var(--color-warning);
  }

  .result-details {
    padding: 16px 0;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow-y: auto;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-xs);
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .history-item-dpi {
    font-weight: 500;
    color: var(--color-ink);
  }

  .history-item-meta {
    color: var(--color-mute);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tool-layout {
      grid-template-columns: 1fr;
    }

    .tool-settings,
    .tool-results {
      position: static;
    }

    .tool-settings {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }

    .tool-settings h3 {
      grid-column: 1 / -1;
    }

    .tool-settings .instructions {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .tool-settings {
      grid-template-columns: 1fr;
    }

    .test-area-inner {
      height: 300px;
    }

    .live-stats {
      flex-wrap: wrap;
      gap: 8px;
    }

    .live-stat-divider {
      display: none;
    }

    .live-stat {
      min-width: 40%;
      flex: unset;
    }
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .modal-content {
    width: 100%;
    max-width: 400px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: 16px;
  }
</style>

<script>
  // ─── DPI Measurement Engine ───
  const dpiToolEl = document.getElementById("dpi-tool") as HTMLElement;
  const langCode = dpiToolEl?.dataset.lang || "en";
  const tStrings = JSON.parse(dpiToolEl?.dataset.translations || "{}");

  const WARNING_TRANSLATIONS: Record<string, string> = {
    en: "Please calibrate your screen in the settings before starting.",
    de: "Bitte kalibrieren Sie Ihren Bildschirm in den Einstellungen, bevor Sie starten.",

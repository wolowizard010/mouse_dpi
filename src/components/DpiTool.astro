      physical: "линейку",
      template: "Физически переместите мышь на {dist}, используя {rulerType} {arrow}"
    },
    zh: {
      virtual: "虚拟尺子",
      physical: "实体尺子",
      template: "请使用您的 {rulerType} 将鼠标物理移动 {dist} {arrow}"
    },
    sv: {
      virtual: "virtuella linjal",
      physical: "linjal",

---
// DpiTool.astro — Core DPI measurement engine
// Uses Pointer Lock API for accurate, unaccelerated mouse movement tracking
---

<section class="dpi-tool" id="dpi-tool">
  <div class="tool-layout">
    <!-- Settings Panel -->
    <div class="tool-settings card" id="settings-panel">
      <h3 class="display-sm" style="margin: 0 0 20px;">Settings</h3>

      <div class="setting-group">
        <label class="setting-label body-sm">Target Distance</label>
        <div class="setting-row">
          <input
            type="number"
            class="input"
            id="target-distance"
            value="5"
            min="0.5"
            max="20"
            step="0.5"
          />
          <div class="unit-toggle" id="unit-toggle">
            <button class="unit-btn active" data-unit="inch" id="unit-inch">inch</button>
            <button class="unit-btn" data-unit="cm" id="unit-cm">cm</button>
          </div>
        </div>
      </div>

      <div class="setting-group">
        <label class="setting-label body-sm">Configured DPI <span class="optional">(optional)</span></label>
        <input
          type="number"
          class="input"
          id="configured-dpi"
          placeholder="e.g. 800"
          min="100"
          max="32000"
          step="50"
        />
      </div>

      <div class="setting-group">
        <label class="setting-label body-sm">Virtual Ruler</label>
        <div class="setting-row" style="align-items: center; cursor: pointer;">
          <input type="checkbox" id="virtual-ruler-cb" style="cursor: pointer;" />
          <label for="virtual-ruler-cb" class="body-sm" style="margin-left: 8px; cursor: pointer;">Use virtual ruler</label>
        </div>
      </div>

      <div id="calibration-settings" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-hairline); transition: background 0.3s ease; border-radius: var(--radius-sm); padding-left: 8px; padding-right: 8px;">
        <h4 class="body-sm" style="font-weight: 500; margin: 0 0 12px;">Screen Calibration</h4>
        <div class="setting-group">
          <label class="setting-label body-sm">Screen diagonal (inches)</label>
          <input type="number" class="input" id="screen-diagonal" placeholder="e.g. 24" min="5" max="50" step="0.1" />
        </div>
        <div class="setting-group">
          <label class="setting-label body-sm">Resolution</label>
          <div style="display: flex; gap: 8px; align-items: center;">
            <input type="number" class="input" id="screen-width" placeholder="1920" />
            <span class="body-sm" style="color: var(--color-mute);">×</span>
            <input type="number" class="input" id="screen-height" placeholder="1080" />
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" id="calc-ppi-btn" style="width: 100%;">Calibrate Screen</button>
        <div class="body-sm" id="calibration-status-text" style="color: var(--color-mute); margin-top: 8px; text-align: center;">Not calibrated</div>
      </div>

      <div class="setting-group">
        <label class="setting-label body-sm">Axis</label>
        <div class="unit-toggle" id="axis-toggle">
          <button class="unit-btn active" data-axis="x" id="axis-x">Horizontal</button>
          <button class="unit-btn" data-axis="y" id="axis-y">Vertical</button>
        </div>
      </div>

      <button class="btn btn-secondary btn-sm" id="reset-btn" style="width: 100%; margin-top: 12px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
        Reset
      </button>

      <!-- Instructions -->
      <div class="instructions card-soft" style="margin-top: 20px; padding: 16px;">
        <p class="caption-mono" style="margin: 0 0 8px; color: var(--color-mute);">How to test</p>
        <ol class="instruction-list body-sm">
          <li>Set your target distance</li>
          <li>Click the test area to lock cursor</li>
          <li>Move your mouse the target distance</li>
          <li>Click again to finish measuring</li>
        </ol>
      </div>
    </div>

    <!-- Test Area -->
    <div class="tool-test-wrapper">
      <div class="test-area card" id="test-area">
        <div class="test-area-inner" id="test-area-inner">
          <!-- Crosshair -->
          <div class="crosshair" id="crosshair">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="var(--color-hairline)" stroke-width="1" stroke-dasharray="4 4"/>
              <line x1="20" y1="4" x2="20" y2="16" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="20" y1="24" x2="20" y2="36" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4" y1="20" x2="16" y2="20" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="24" y1="20" x2="36" y2="20" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="20" cy="20" r="2" fill="var(--color-link)"/>
            </svg>
          </div>

          <!-- State overlay -->
          <div class="test-overlay" id="test-overlay">
            <div class="test-prompt" id="test-prompt">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 3l14 9-14 9V3z"></path>
              </svg>
              <span class="body-md" id="test-prompt-title" style="font-weight: 500;">Click to start measuring</span>
              <span class="body-sm" id="test-prompt-desc" style="color: var(--color-mute);">Cursor will be locked for accurate tracking</span>
            </div>
          </div>

          <!-- Active state info -->
          <div class="test-active-info" id="test-active-info" style="display: none;">
            <div class="live-counter">
              <span class="caption-mono" style="color: var(--color-mute);">Pixels moved</span>
              <span class="live-pixels display-lg" id="live-pixels">0</span>
            </div>
            <div class="live-direction" id="live-direction">
              <span class="caption-mono" id="direction-label" style="color: var(--color-mute);">Move mouse →</span>
            </div>
            
            <div id="on-screen-ruler-wrapper" style="display: none; width: 100%; max-width: 800px; border-radius: var(--radius-sm); margin-top: 16px;">
              <canvas id="ruler-canvas" style="display: block; width: 100%; min-height: 80px;"></canvas>
            </div>
          </div>
        </div>

        <!-- Gradient border animation -->
        <div class="test-area-border" id="test-area-border"></div>
      </div>

      <!-- Real-time stats bar -->
      <div class="live-stats" id="live-stats">
        <div class="live-stat">
          <span class="caption-mono">PIXELS</span>
          <span class="stat-value code-text" id="stat-pixels">0</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">DISTANCE</span>
          <span class="stat-value code-text" id="stat-distance">0.00 in</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">DPI</span>
          <span class="stat-value code-text" id="stat-dpi">—</span>
        </div>
        <div class="live-stat-divider"></div>
        <div class="live-stat">
          <span class="caption-mono">STATUS</span>
          <span class="stat-value stat-status code-text" id="stat-status">Ready</span>
        </div>
      </div>
    </div>

    <!-- Results Panel -->
    <div class="tool-results card" id="results-panel">
      <h3 class="display-sm" style="margin: 0 0 20px;">Results</h3>

      <!-- Main DPI result -->
      <div class="result-main" id="result-main">
        <span class="caption-mono" style="color: var(--color-mute);">Measured DPI</span>
        <span class="result-dpi display-xl" id="result-dpi">—</span>
      </div>

      <!-- Comparison -->
      <div class="result-comparison" id="result-comparison" style="display: none;">
        <div class="comparison-bar">
          <div class="comparison-configured">
            <span class="body-sm" style="font-weight: 500;">Configured</span>
            <span class="code-text" id="comparison-configured-val">—</span>
          </div>
          <div class="comparison-vs body-sm" style="color: var(--color-mute);">vs</div>
          <div class="comparison-measured">
            <span class="body-sm" style="font-weight: 500;">Measured</span>
            <span class="code-text" id="comparison-measured-val">—</span>
          </div>
        </div>
        <div class="comparison-diff" id="comparison-diff"></div>
      </div>

      <!-- Details -->
      <div class="result-details" id="result-details" style="display: none;">
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">Pixels moved</span>
          <span class="code-text" id="detail-pixels">—</span>
        </div>
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">Target distance</span>
          <span class="code-text" id="detail-distance">—</span>
        </div>
        <div class="detail-row">
          <span class="body-sm" style="color: var(--color-body);">Axis</span>
          <span class="code-text" id="detail-axis">—</span>
        </div>
      </div>

      <!-- History -->
      <div class="result-history" id="result-history">
        <h4 class="caption-mono" style="margin: 24px 0 12px; color: var(--color-mute);">Test History</h4>
        <div class="history-empty body-sm" id="history-empty" style="color: var(--color-mute);">
          No tests yet. Click the test area to begin.
        </div>
        <div class="history-list" id="history-list"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .dpi-tool {
    width: 100%;
  }

  .tool-layout {
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 20px;
    align-items: start;
  }

  /* Settings */
  .tool-settings {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .setting-group {
    margin-bottom: 16px;
  }

  .setting-label {
    display: block;
    color: var(--color-body);
    margin-bottom: 6px;
    font-weight: 500;
  }

  .optional {
    color: var(--color-mute);
    font-weight: 400;
  }

  .setting-row {
    display: flex;
    gap: 8px;
  }

  .setting-row .input {
    flex: 1;
  }

  .unit-toggle {
    display: flex;
    background: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
    padding: 2px;
    gap: 2px;
  }

  .unit-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 7px 14px;
    border: none;
    background: transparent;
    color: var(--color-body);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .unit-btn.active {
    background: var(--color-ink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  .instruction-list {
    margin: 0;
    padding-left: 18px;
    color: var(--color-body);
  }

  .instruction-list li {
    margin-bottom: 4px;
  }

  .instruction-list kbd {
    display: inline-block;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    box-shadow: 0 1px 0 var(--color-hairline);
  }

  /* Test Area */
  .tool-test-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .test-area {
    position: relative;
    min-height: 420px;
    cursor: crosshair;
    overflow: hidden;
    padding: 0;
  }

  .test-area-inner {
    position: relative;
    width: 100%;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: 
      linear-gradient(var(--color-hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
  }

  .crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .test-area:hover .crosshair {
    opacity: 0.7;
  }

  .test-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .test-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--color-ink);
    background: var(--c-overlay);
    backdrop-filter: blur(8px);
    padding: 32px 48px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
  }

  .test-active-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 2;
    pointer-events: none;
  }

  .live-counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .live-pixels {
    color: var(--color-link);
    font-variant-numeric: tabular-nums;
  }

  .live-direction {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .test-area-border {
    position: absolute;
    inset: -2px;
    border-radius: var(--radius-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .test-area.active .test-area-border {
    opacity: 1;
    background: linear-gradient(135deg, 
      var(--color-grad-develop-start), 
      var(--color-grad-develop-end),
      var(--color-grad-preview-start),
      var(--color-grad-preview-end)
    );
    animation: border-rotate 4s linear infinite;
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 2px;
  }

  @keyframes border-rotate {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }

  .test-area.active {
    cursor: none;
  }

  .test-area.active .test-overlay {
    opacity: 0;
    pointer-events: none;
  }

  /* Live stats bar */
  .live-stats {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-radius: var(--radius-md);
    padding: 12px 20px;
    overflow-x: auto;
  }

  .live-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .live-stat .caption-mono {
    color: var(--color-hairline-strong);
    font-size: 10px;
  }

  .stat-value {
    color: var(--color-on-primary);
    font-variant-numeric: tabular-nums;
  }

  .stat-status {
    color: var(--color-cyan);
  }

  .live-stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 16px;
    flex-shrink: 0;
  }

  /* Results */
  .tool-results {
    padding: 24px;
    position: sticky;
    top: 84px;
  }

  .result-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .result-dpi {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  .result-dpi.success {
    color: var(--color-success);
  }

  .result-comparison {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .comparison-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .comparison-configured,
  .comparison-measured {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: center;
  }

  .comparison-diff {
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-family: var(--font-mono);
    text-align: center;
  }

  .comparison-diff.match {
    background: rgba(0, 112, 243, 0.08);
    color: var(--color-link);
  }

  .comparison-diff.off {
    background: rgba(245, 166, 35, 0.08);
    color: var(--color-warning);
  }

  .result-details {
    padding: 16px 0;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow-y: auto;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-xs);
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .history-item-dpi {
    font-weight: 500;
    color: var(--color-ink);
  }

  .history-item-meta {
    color: var(--color-mute);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tool-layout {
      grid-template-columns: 1fr;
    }

    .tool-settings,
    .tool-results {
      position: static;
    }

    .tool-settings {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }

    .tool-settings h3 {
      grid-column: 1 / -1;
    }

    .tool-settings .instructions {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .tool-settings {
      grid-template-columns: 1fr;
    }

    .test-area-inner {
      height: 300px;
    }

    .live-stats {
      flex-wrap: wrap;
      gap: 8px;
    }

    .live-stat-divider {
      display: none;
    }

    .live-stat {
      min-width: 40%;
      flex: unset;
    }
  }
</style>

<script>
  // ─── DPI Measurement Engine ───
  const testArea = document.getElementById("test-area") as HTMLElement;
  const testOverlay = document.getElementById("test-overlay") as HTMLElement;
  const testActiveInfo = document.getElementById("test-active-info") as HTMLElement;
  const livePixels = document.getElementById("live-pixels") as HTMLElement;
  const directionFill = document.getElementById("direction-fill") as HTMLElement;
  const directionLabel = document.getElementById("direction-label") as HTMLElement;

  // Stats
  const statPixels = document.getElementById("stat-pixels") as HTMLElement;
  const statDistance = document.getElementById("stat-distance") as HTMLElement;
  const statDpi = document.getElementById("stat-dpi") as HTMLElement;
  const statStatus = document.getElementById("stat-status") as HTMLElement;

  // Results
  const resultDpi = document.getElementById("result-dpi") as HTMLElement;
  const resultComparison = document.getElementById("result-comparison") as HTMLElement;
  const comparisonConfiguredVal = document.getElementById("comparison-configured-val") as HTMLElement;
  const comparisonMeasuredVal = document.getElementById("comparison-measured-val") as HTMLElement;
  const comparisonDiff = document.getElementById("comparison-diff") as HTMLElement;
  const resultDetails = document.getElementById("result-details") as HTMLElement;
  const detailPixels = document.getElementById("detail-pixels") as HTMLElement;
  const detailDistance = document.getElementById("detail-distance") as HTMLElement;
  const detailAxis = document.getElementById("detail-axis") as HTMLElement;
  const historyEmpty = document.getElementById("history-empty") as HTMLElement;
  const historyList = document.getElementById("history-list") as HTMLElement;

  // Settings
  const targetDistanceInput = document.getElementById("target-distance") as HTMLInputElement;
  const configuredDpiInput = document.getElementById("configured-dpi") as HTMLInputElement;
  const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement;

  // State
  let isActive = false;
  let totalDeltaX = 0;
  let totalDeltaY = 0;
  let currentUnit: "inch" | "cm" = "inch";
  let currentAxis: "x" | "y" = "x";
  let usingRawInput = false; // Whether unadjustedMovement was granted
  let history: Array<{ dpi: number; pixels: number; distance: string; axis: string; time: string }> = [];

  // Calibration State
  let currentPPI = 96;
  let isCalibrated = false;
  const virtualRulerCb = document.getElementById("virtual-ruler-cb") as HTMLInputElement;
  const calibrationSettings = document.getElementById("calibration-settings") as HTMLElement;
  const screenWidthInput = document.getElementById("screen-width") as HTMLInputElement;
  const screenHeightInput = document.getElementById("screen-height") as HTMLInputElement;
  const screenDiagonalInput = document.getElementById("screen-diagonal") as HTMLInputElement;
  const calcPpiBtn = document.getElementById("calc-ppi-btn") as HTMLButtonElement;
  const calibrationStatusText = document.getElementById("calibration-status-text") as HTMLElement;
  const onScreenRulerWrapper = document.getElementById("on-screen-ruler-wrapper") as HTMLElement;
  const rulerCanvas = document.getElementById("ruler-canvas") as HTMLCanvasElement;
  const rulerCtx = rulerCanvas?.getContext("2d");

  // Init Calibration
  // No auto-calibration; user must manually fill fields

  virtualRulerCb?.addEventListener("change", () => {
    if (calibrationSettings) {
      calibrationSettings.style.display = virtualRulerCb.checked ? "block" : "none";
    }
  });

  calcPpiBtn?.addEventListener("click", () => {
    const diagonal = parseFloat(screenDiagonalInput.value);
    const width = parseInt(screenWidthInput.value);
    const height = parseInt(screenHeightInput.value);
    if (diagonal > 0 && width > 0 && height > 0) {
      const dpr = window.devicePixelRatio || 1;
      const diagonalPixels = Math.sqrt(width * width + height * height);
      currentPPI = (diagonalPixels / diagonal) / dpr;
      isCalibrated = true;
      if (calibrationStatusText) {
        calibrationStatusText.textContent = `Calibrated: ${Math.round(currentPPI)} PPI`;
        calibrationStatusText.style.color = "var(--color-success)";
      }
      if (isActive && virtualRulerCb.checked) drawRuler();
    } else {
      alert("Please enter valid screen diagonal and resolution values.");
    }
  });

  // Ruler Drawing Logic
  function getRulerColors() {
    const theme = document.documentElement.getAttribute("data-theme");
    const isDark = theme === "dark";
    return {
      background: isDark ? "#0a0a0a" : "#ffffff",
      rulerBody: isDark ? "#111111" : "#fafafa",
      topBorder: isDark ? "#ededed" : "#171717",
      majorTick: isDark ? "#ededed" : "#171717",
      halfTick: isDark ? "#a1a1a1" : "#4d4d4d",
      quarterTick: isDark ? "#666666" : "#888888",
      minorTick: isDark ? "#333333" : "#cccccc",
      labelColor: isDark ? "#ededed" : "#171717",
      unitLabel: isDark ? "#666666" : "#888888",
      dividerLine: isDark ? "#2a2a2a" : "#ebebeb",
      infoText: isDark ? "#666666" : "#888888",
    };
  }

  function drawRuler() {
    if (!rulerCanvas || !rulerCtx) return;
    const canvasDpr = window.devicePixelRatio || 1;
    const displayWidth = testArea.clientWidth - 40; // some padding
    const displayHeight = 80;

    rulerCanvas.width = displayWidth * canvasDpr;
    rulerCanvas.height = displayHeight * canvasDpr;
    rulerCanvas.style.width = `${displayWidth}px`;
    rulerCanvas.style.height = `${displayHeight}px`;
    rulerCtx.scale(canvasDpr, canvasDpr);

    const colors = getRulerColors();
    rulerCtx.fillStyle = colors.background;
    rulerCtx.fillRect(0, 0, displayWidth, displayHeight);

    const pixelsPerUnit = currentUnit === "cm" ? currentPPI / 2.54 : currentPPI;
    const subdivisionsPerUnit = currentUnit === "cm" ? 10 : 16;
    const pixelsPerSubdivision = pixelsPerUnit / subdivisionsPerUnit;
    const totalUnits = Math.floor(displayWidth / pixelsPerUnit) + 1;

    rulerCtx.fillStyle = colors.rulerBody;
    rulerCtx.fillRect(0, 0, displayWidth, displayHeight);
    rulerCtx.fillStyle = colors.topBorder;
    rulerCtx.fillRect(0, 0, displayWidth, 2);

    for (let unit = 0; unit <= totalUnits; unit++) {
      for (let sub = 0; sub < subdivisionsPerUnit; sub++) {
        const x = unit * pixelsPerUnit + sub * pixelsPerSubdivision;
        if (x > displayWidth) break;

        let tickHeight, tickWidth, color;
        if (sub === 0) {
          tickHeight = 30; tickWidth = 1.5; color = colors.majorTick;
        } else if ((currentUnit === "cm" && sub === 5) || (currentUnit === "inch" && sub === 8)) {
          tickHeight = 20; tickWidth = 1; color = colors.halfTick;
        } else if (currentUnit === "inch" && (sub === 4 || sub === 12)) {
          tickHeight = 15; tickWidth = 1; color = colors.quarterTick;
        } else {
          tickHeight = 8; tickWidth = 0.5; color = colors.minorTick;
        }

        rulerCtx.fillStyle = color;
        rulerCtx.fillRect(Math.round(x) - tickWidth / 2, 2, tickWidth, tickHeight);

        if (sub === 0 && unit > 0) {
          rulerCtx.fillStyle = colors.labelColor;
          rulerCtx.font = "500 13px 'Geist', 'Inter', system-ui, sans-serif";
          rulerCtx.textAlign = "center";
          rulerCtx.fillText(String(unit), Math.round(x), 45);
        }
      }
    }
    rulerCtx.fillStyle = colors.unitLabel;
    rulerCtx.font = "400 11px 'Geist Mono', monospace";
    rulerCtx.textAlign = "left";
    rulerCtx.fillText(currentUnit === "cm" ? "cm" : "inches", 6, 60);
  }

  window.addEventListener("resize", () => {
    if (isActive && virtualRulerCb.checked) drawRuler();
  });
  window.addEventListener("theme-changed", () => {
    if (isActive && virtualRulerCb.checked) drawRuler();
  });

  function updateDirectionLabel() {
    if (!directionLabel) return;
    const isVirtual = virtualRulerCb && virtualRulerCb.checked;
    const rulerType = isVirtual ? "virtual ruler" : "ruler";
    const dist = getTargetDisplay();
    const arrow = currentAxis === "x" ? "→" : "↓";
    directionLabel.textContent = `Physically move your mouse ${dist} using your ${rulerType} ${arrow}`;
  }

  // Unit toggle
  document.querySelectorAll("#unit-toggle .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#unit-toggle .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      currentUnit = (btn as HTMLElement).dataset.unit as "inch" | "cm";
      updateLiveStats();
      updateDirectionLabel();
      if (isActive && virtualRulerCb.checked) drawRuler();
    });
  });

  // Axis toggle
  document.querySelectorAll("#axis-toggle .unit-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#axis-toggle .unit-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      currentAxis = (btn as HTMLElement).dataset.axis as "x" | "y";
      updateDirectionLabel();
    });
  });

  if (targetDistanceInput) {
    targetDistanceInput.addEventListener("input", () => {
      updateLiveStats();
      updateDirectionLabel();
    });
  }

  // Get target distance in inches
  function getTargetInches(): number {
    const val = parseFloat(targetDistanceInput.value) || 5;
    return currentUnit === "cm" ? val / 2.54 : val;
  }

  function getTargetDisplay(): string {
    const val = parseFloat(targetDistanceInput.value) || 5;
    return `${val} ${currentUnit === "cm" ? "cm" : "in"}`;
  }

  // Get pixels moved along active axis
  function getAxisPixels(): number {
    const rawPixels = Math.abs(currentAxis === "x" ? totalDeltaX : totalDeltaY);
    if (usingRawInput) {
      // With unadjustedMovement, movementX/Y are raw hardware counts
      // — no OS processing, no DPR scaling. Direct 1:1 with mouse DPI.
      return Math.round(rawPixels);
    }
    // Fallback: without unadjustedMovement, values are in CSS pixels
    // and may be scaled by devicePixelRatio on high-DPI displays.
    const dpr = window.devicePixelRatio || 1;
    return Math.round(rawPixels * dpr);
  }

  // Calculate DPI
  function calculateDpi(): number {
    const pixels = getAxisPixels();
    const inches = getTargetInches();
    if (inches <= 0) return 0;
    return Math.round(pixels / inches);
  }

  // Update live stats
  function updateLiveStats() {
    const pixels = getAxisPixels();
    const dpi = calculateDpi();
    const targetInches = getTargetInches();
    const distanceInInches = targetInches > 0 ? pixels / (dpi || 1) : 0;

    if (livePixels) livePixels.textContent = String(pixels);
    if (statPixels) statPixels.textContent = String(pixels);
    if (statDistance) statDistance.textContent = `${getTargetDisplay()}`;
    if (statDpi) statDpi.textContent = isActive && pixels > 10 ? String(dpi) : "—";
  }

  // Start test — request pointer lock with unadjusted (raw) movement
  function startTest() {
    if (isActive) return;

    // Try to get raw, unprocessed mouse input via unadjustedMovement.
    // This bypasses OS-level pointer acceleration, speed scaling, and
    // DPR transformations — giving us true hardware DPI counts.
    // Falls back to standard pointer lock if not supported.
    try {
      const promise = (testArea as any).requestPointerLock({
        unadjustedMovement: true,
      });
      if (promise instanceof Promise) {
        promise
          .then(() => {
            usingRawInput = true;
          })
          .catch(() => {
            // unadjustedMovement not supported — fall back
            usingRawInput = false;
            testArea.requestPointerLock();
          });
      } else {
        // Older API returns void, pointer lock was already requested
        usingRawInput = false;
      }
    } catch {
      // Options parameter not supported at all
      usingRawInput = false;
      testArea.requestPointerLock();
    }
  }

  // Handle pointer lock change
  document.addEventListener("pointerlockchange", () => {
    if (document.pointerLockElement === testArea) {
      // Locked — start tracking
      isActive = true;
      totalDeltaX = 0;
      totalDeltaY = 0;
      testArea.classList.add("active");
      if (testActiveInfo) testActiveInfo.style.display = "flex";
      if (virtualRulerCb?.checked && onScreenRulerWrapper) {
        onScreenRulerWrapper.style.display = "block";
        drawRuler();
      }
      if (statStatus) {
        statStatus.textContent = usingRawInput ? "Measuring (raw)" : "Measuring...";
        statStatus.style.color = "var(--color-cyan)";
      }
      updateLiveStats();
      updateDirectionLabel();
      document.addEventListener("mousemove", onMouseMove);
      document.addEventListener("mousedown", onMouseDown);
    } else {
      // Unlocked — finalize
      isActive = false;
      testArea.classList.remove("active");
      if (testActiveInfo) testActiveInfo.style.display = "none";
      if (onScreenRulerWrapper) onScreenRulerWrapper.style.display = "none";
      document.removeEventListener("mousemove", onMouseMove);
      document.removeEventListener("mousedown", onMouseDown);
      finishTest();
    }
  });

  function onMouseMove(e: MouseEvent) {
    totalDeltaX += e.movementX;
    totalDeltaY += e.movementY;
    updateLiveStats();
  }

  function onMouseDown(e: MouseEvent) {
    if (e.button === 0 && isActive) {
      e.preventDefault();
      document.exitPointerLock();
    }
  }

  function finishTest() {
    const pixels = getAxisPixels();
    if (pixels < 10) {
      if (statStatus) {
        statStatus.textContent = "Too short";
        statStatus.style.color = "var(--color-warning)";
      }
      return;
    }

    const dpi = calculateDpi();

    // Update results
    if (resultDpi) {
      resultDpi.textContent = String(dpi);
      resultDpi.classList.add("success");
      setTimeout(() => resultDpi.classList.remove("success"), 2000);
    }

    if (statStatus) {
      statStatus.textContent = "Complete";
      statStatus.style.color = "#50e3c2";
    }

    if (statDpi) statDpi.textContent = String(dpi);

    // Details
    if (resultDetails) resultDetails.style.display = "block";
    if (detailPixels) detailPixels.textContent = String(pixels);
    if (detailDistance) detailDistance.textContent = getTargetDisplay();
    if (detailAxis) detailAxis.textContent = currentAxis === "x" ? "Horizontal" : "Vertical";

    // Comparison
    const configuredDpi = parseInt(configuredDpiInput.value);
    if (configuredDpi > 0 && resultComparison) {
      resultComparison.style.display = "block";
      if (comparisonConfiguredVal) comparisonConfiguredVal.textContent = String(configuredDpi);
      if (comparisonMeasuredVal) comparisonMeasuredVal.textContent = String(dpi);

      const diff = dpi - configuredDpi;
      const pctDiff = ((diff / configuredDpi) * 100).toFixed(1);

      if (comparisonDiff) {
        if (Math.abs(parseFloat(pctDiff)) < 5) {
          comparisonDiff.className = "comparison-diff match";
          comparisonDiff.textContent = `✓ Match — ${pctDiff}% difference`;
        } else {
          comparisonDiff.className = "comparison-diff off";
          comparisonDiff.textContent = `${diff > 0 ? "+" : ""}${pctDiff}% difference (${diff > 0 ? "+" : ""}${diff} DPI)`;
        }
      }
    }

    // History
    const entry = {
      dpi,
      pixels,
      distance: getTargetDisplay(),
      axis: currentAxis === "x" ? "H" : "V",
      time: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" }),
    };
    history.unshift(entry);

    if (historyEmpty) historyEmpty.style.display = "none";
    if (historyList) {
      const item = document.createElement("div");
      item.className = "history-item";
      item.innerHTML = `
        <span class="history-item-dpi">${entry.dpi} DPI</span>
        <span class="history-item-meta">${entry.pixels}px · ${entry.distance} · ${entry.axis} · ${entry.time}</span>
      `;
      historyList.prepend(item);
    }
  }

  function showCalibrationWarning() {
    const testPromptDesc = document.getElementById("test-prompt-desc");
    if (testPromptDesc) {
      const originalText = testPromptDesc.textContent;
      const originalColor = testPromptDesc.style.color;
      testPromptDesc.textContent = "Please calibrate your screen in the settings before starting.";
      testPromptDesc.style.color = "var(--color-warning)";
      setTimeout(() => {
        testPromptDesc.textContent = originalText;
        testPromptDesc.style.color = originalColor;
      }, 3000);
    }
    if (calibrationSettings) {
      calibrationSettings.style.background = "var(--color-canvas-soft-2)";
      setTimeout(() => calibrationSettings.style.background = "transparent", 1000);
    }
  }

  // Click to start
  testArea.addEventListener("click", () => {
    if (!isActive) {
      if (virtualRulerCb.checked && !isCalibrated) {
        showCalibrationWarning();
        return;
      }
      startTest();
    }
  });

  // Reset
  resetBtn.addEventListener("click", () => {
    totalDeltaX = 0;
    totalDeltaY = 0;
    history = [];

    if (resultDpi) resultDpi.textContent = "—";
    if (resultComparison) resultComparison.style.display = "none";
    if (resultDetails) resultDetails.style.display = "none";
    if (statPixels) statPixels.textContent = "0";
    if (statDpi) statDpi.textContent = "—";
    if (statStatus) {
      statStatus.textContent = "Ready";
      statStatus.style.color = "var(--color-cyan)";
    }
    if (historyEmpty) historyEmpty.style.display = "block";
    if (historyList) historyList.innerHTML = "";
    if (livePixels) livePixels.textContent = "0";
  });

  // Keyboard shortcut: Space to start
  document.addEventListener("keydown", (e) => {
    if (e.code === "Space" && !isActive && document.activeElement === document.body) {
      e.preventDefault();
      if (virtualRulerCb.checked && !isCalibrated) {
        showCalibrationWarning();
        return;
      }
      startTest();
    }
  });
</script>

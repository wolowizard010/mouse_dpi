      physical: "lineal",
      template: "Flyt din mus fysisk {dist} ved hjælp af din {rulerType} {arrow}"
    },
    no: {
      virtual: "virtuelle lineal",
      physical: "lineal",
      template: "Flytt musen fysisk {dist} ved hjelp av din {rulerType} {arrow}"
    },
    fi: {

      physical: "liniaal",
      template: "Beweeg uw muis fysiek {dist} met behulp van uw {rulerType} {arrow}"
    },
    pl: {
      virtual: "wirtualnej linijki",
      physical: "linijki",
      template: "Przesuń fizycznie mysz o {dist}, używając {rulerType} {arrow}"
    },
    pt: {
      virtual: "régua virtual",

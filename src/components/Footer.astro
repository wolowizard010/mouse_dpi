---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);

const footerSections = [
  {
    title: t("footer.tools"),
    links: [
      { label: t("nav.dpiAnalyzer"), path: "dpi-analyzer" },
      { label: t("nav.screenRuler"), path: "screen-ruler" },
    ],
  },
  {
    title: t("footer.resources"),
    links: [
      { label: t("nav.howItWorks"), path: "how-it-works" },
    ],
  },
  {
    title: t("footer.company"),
    links: [
      { label: t("footer.about"), path: "about" },
      { label: t("footer.contact"), path: "contact" },
      { label: t("footer.privacy"), path: "privacy-policy" },
      { label: t("footer.terms"), path: "terms-and-conditions" },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href={getRelativeLocaleUrl(lang, "")} class="footer-logo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="4" fill="currentColor"/>
            <path d="M8 7L8 17M12 10L12 17M16 7L16 17" stroke="var(--color-on-primary)" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>{t("nav.logo")}</span>
        </a>
        <p class="footer-tagline" set:html={t("footer.tagline")}></p>
      </div>

      <!-- Link columns -->
      {footerSections.map((section) => (
        <div class="footer-column">
          <h4 class="footer-column-title caption-mono">{section.title}</h4>
          <ul class="footer-column-links">
            {section.links.map((link) => (
              <li>
                <a href={getRelativeLocaleUrl(lang, link.path)} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">© {new Date().getFullYear()} {t("footer.copyright")}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    padding: 64px 0 32px;
    margin-top: 96px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--color-mute);
    line-height: 22px;
    margin: 0;
  }

  .footer-column-title {
    margin: 0 0 16px;
    color: var(--color-mute);
  }

  .footer-column-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }

  .footer-copyright {
    font-size: 12px;
    color: var(--color-mute);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Contact Us - My Mouse DPI"
  description="Contact us at My Mouse DPI for any questions or feedback."
>
  <Navbar />
  <main class="page-container container">
    <div style="max-width: 720px;">
      <div style="margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--color-hairline);">
        <span class="caption-mono" style="color: var(--color-mute);">Contact</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">Contact Us.</h1>
      </div>
      <div class="content">
        <p class="body-lg" style="color: var(--color-body); margin-bottom: 24px;">
          We'd love to hear from you! If you have any questions, feedback, or need assistance with our tools, please feel free to reach out to us using the form below.
        </p>

        <form class="contact-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Message sent successfully!');">
          <div class="form-group">
            <label for="name" class="body-md" style="font-weight: 500;">Your Name</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="Jane Doe" required />
          </div>
          <div class="form-group">
            <label for="email" class="body-md" style="font-weight: 500;">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="jane@example.com" required />
          </div>
          <div class="form-group">
            <label for="message" class="body-md" style="font-weight: 500;">Message</label>
            <textarea id="message" name="message" rows="5" class="form-input" placeholder="How can we help you?" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: 16px; align-self: flex-start;">Send Message</button>
        </form>

        <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--color-hairline);">
          <p class="body-md" style="color: var(--color-body);">
            <strong>Email:</strong> <a href="mailto:jasdeep97.dev@gmail.com" style="color: var(--color-link); text-decoration: none;">jasdeep97.dev@gmail.com</a>
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: 48px 0 0;
    margin-bottom: 64px;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-input {
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
    color: var(--color-ink);
    font-family: inherit;
    font-size: 16px;
    transition: border-color 0.15s ease;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--color-link);
  }
  .form-input::placeholder {
    color: var(--color-mute);
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Mouse DPI Analyzer — Accurate DPI Measurement Tool"
  description="Measure your mouse DPI with precision. Free online tool with screen calibration, on-screen ruler, and real-time DPI calculation."
>
  <Navbar />

  <!-- Hero Band -->
  <section class="hero">
    <div class="hero-gradient mesh-gradient"></div>
    <div class="container hero-content">
      <div class="hero-badge badge animate-fade-in">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
        </svg>
        Free & instant — no download needed
      </div>
      <h1 class="display-xl hero-title animate-fade-in delay-1">
        Measure your mouse DPI<br/>with precision.
      </h1>
      <p class="body-lg hero-subtitle animate-fade-in delay-2">
        Accurate DPI measurement using Pointer Lock API for raw mouse input.<br class="hide-mobile"/>
        Calibrate your screen, test your mouse, and verify your settings.
      </p>
      <div class="hero-cta animate-fade-in delay-3">
        <a href="/dpi-analyzer" class="btn btn-primary" id="hero-cta-primary">
          Test Your DPI
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/screen-ruler" class="btn btn-secondary" id="hero-cta-secondary">
          Screen Ruler
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <span class="caption-mono" style="color: var(--color-mute);">Features</span>
        <h2 class="display-lg" style="margin: 8px 0 0;">Built for accuracy.</h2>
      </div>

      <div class="features-grid">
        <div class="card feature-card animate-slide-up delay-1">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-link)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="22" y1="12" x2="18" y2="12"></line>
              <line x1="6" y1="12" x2="2" y2="12"></line>
              <line x1="12" y1="6" x2="12" y2="2"></line>
              <line x1="12" y1="22" x2="12" y2="18"></line>
            </svg>
          </div>
          <h3 class="display-sm" style="margin: 16px 0 8px;">Pointer Lock API</h3>
          <p class="body-md" style="color: var(--color-body); margin: 0;">
            Uses raw, unaccelerated mouse input for true hardware-level DPI measurement. Bypasses OS mouse acceleration.
          </p>
        </div>

        <div class="card feature-card animate-slide-up delay-2">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          </div>
          <h3 class="display-sm" style="margin: 16px 0 8px;">Screen Calibration</h3>
          <p class="body-md" style="color: var(--color-body); margin: 0;">
            On-screen ruler with credit card calibration. No physical ruler needed — calibrate once, accurate forever.
          </p>
        </div>

        <div class="card feature-card animate-slide-up delay-3">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3 class="display-sm" style="margin: 16px 0 8px;">Real-time Results</h3>
          <p class="body-md" style="color: var(--color-body); margin: 0;">
            See your DPI calculated live as you move. Test history tracks multiple runs so you can verify consistency.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how-section">
    <div class="container">
      <div class="section-header">
        <span class="caption-mono" style="color: var(--color-mute);">How it works</span>
        <h2 class="display-lg" style="margin: 8px 0 0;">Three steps to accurate DPI.</h2>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number caption-mono">01</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">Calibrate</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            Use our on-screen ruler to calibrate your display. Match a credit card or enter your screen specifications.
          </p>
        </div>
        <div class="step-divider">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-hairline)" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number caption-mono">02</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">Set distance</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            Choose a target distance in inches or centimeters. Place your mouse at the starting mark.
          </p>
        </div>
        <div class="step-divider">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-hairline)" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number caption-mono">03</div>
          <h3 class="display-sm" style="margin: 12px 0 8px;">Measure</h3>
          <p class="body-sm" style="color: var(--color-body); margin: 0;">
            Click the test area, move your mouse the target distance, and release. Your DPI is calculated instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="container" style="text-align: center;">
      <h2 class="display-lg" style="color: var(--color-on-primary); margin: 0 0 16px;">Ready to test your DPI?</h2>
      <p class="body-lg" style="color: var(--color-hairline-strong); margin: 0 0 32px;">
        Free, accurate, and takes less than 30 seconds.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/dpi-analyzer" class="btn btn-secondary" style="border-color: rgba(255,255,255,0.2);">
          Start DPI Test
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 96px 0 80px;
    overflow: hidden;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    margin-bottom: 24px;
  }

  .hero-title {
    margin: 0 0 20px;
    max-width: 700px;
  }

  .hero-subtitle {
    margin: 0 0 36px;
    color: var(--color-body);
    max-width: 560px;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hide-mobile {
    display: inline;
  }

  /* Features */
  .features-section {
    padding: 96px 0;
  }

  .section-header {
    margin-bottom: 48px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    padding: 32px;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-canvas-soft);
    border-radius: var(--radius-md);
  }

  /* How it works */
  .how-section {
    padding: 96px 0;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .steps-grid {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .step-card {
    flex: 1;
    padding: 24px;
  }

  .step-number {
    color: var(--color-link);
    font-size: 14px;
    letter-spacing: 1px;
  }

  .step-divider {
    display: flex;
    align-items: center;
    padding-top: 32px;
    flex-shrink: 0;
  }

  /* CTA Band */
  .cta-band {
    padding: 96px 0;
    background: var(--color-ink);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 64px 0 48px;
    }

    .hero-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -1.6px;
    }

    .hide-mobile {
      display: none;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid {
      flex-direction: column;
    }

    .step-divider {
      transform: rotate(90deg);
      padding-top: 0;
      padding: 8px 0;
    }
  }
</style>

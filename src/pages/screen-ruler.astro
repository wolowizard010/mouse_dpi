---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScreenRuler from "../components/ScreenRuler.astro";
---

<Layout
  title="On-Screen Ruler — Measure in CM and Inches | Mouse DPI Analyzer"
  description="Free on-screen ruler with screen calibration. Measure accurately in centimeters and inches using monitor specification calibration. No physical ruler needed."
>
  <Navbar />

  <main class="ruler-page">
    <div class="container">
      <div class="page-header">
        <span class="caption-mono" style="color: var(--color-mute);">Tool</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">Screen Ruler.</h1>
        <p class="body-lg" style="color: var(--color-body); margin: 8px 0 0; max-width: 560px;">
          An accurate on-screen ruler for your display. Calibrate by entering your screen specifications for precise real-world measurements.
        </p>
      </div>

      <ScreenRuler />

      <!-- Info section -->
      <div class="info-section" style="margin-top: 64px;">
        <div class="section-header">
          <span class="caption-mono" style="color: var(--color-mute);">About</span>
          <h2 class="display-md" style="margin: 8px 0 0;">Screen calibration</h2>
        </div>

        <div style="margin-top: 32px;">
          <div class="card info-card" style="max-width: 600px;">
            <p class="body-md" style="color: var(--color-body); margin: 0;">
              Enter your monitor's diagonal size (e.g., 27") and its native resolution (e.g., 2560×1440). From these two values, we calculate your exact PPI — pixels per physical inch — so the ruler matches the real world.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .ruler-page {
    padding: 48px 0 0;
  }

  .page-header {
    margin-bottom: 40px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .info-card {
    padding: 32px;
  }

  @media (max-width: 768px) {
    .ruler-page {
      padding: 32px 0 0;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

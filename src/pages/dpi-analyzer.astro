---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import DpiTool from "../components/DpiTool.astro";
import ScreenRuler from "../components/ScreenRuler.astro";
---

<Layout
  title="DPI Analyzer — Test Your Mouse DPI Accurately | Mouse DPI Analyzer"
  description="Test your mouse DPI instantly with our accurate DPI analyzer. Uses Pointer Lock API for raw mouse input. Real-time calculation with test history."
>
  <Navbar />

  <main class="analyzer-page">
    <div class="container">
      <!-- Page Header -->
      <div class="page-header">
        <span class="caption-mono" style="color: var(--color-mute);">Tool</span>
        <h1 class="display-lg" style="margin: 8px 0 0;">DPI Analyzer.</h1>
        <p class="body-lg" style="color: var(--color-body); margin: 8px 0 0; max-width: 520px;">
          Click the test area, move your mouse the target distance, and your DPI is calculated in real-time.
        </p>
      </div>

      <!-- DPI Tool -->
      <DpiTool />

      <!-- Ruler section -->
      <div class="ruler-section-wrapper">
        <div class="section-header" style="margin-top: 64px;">
          <span class="caption-mono" style="color: var(--color-mute);">Reference</span>
          <h2 class="display-md" style="margin: 8px 0 0;">On-Screen Ruler.</h2>
          <p class="body-md" style="color: var(--color-body); margin: 8px 0 0;">
            Use this ruler to measure the exact distance you move your mouse. Calibrate first for accuracy.
          </p>
        </div>
        <div style="margin-top: 32px;">
          <ScreenRuler />
        </div>
      </div>

      <!-- Tips -->
      <div class="tips-section" style="margin-top: 64px;">
        <div class="section-header">
          <span class="caption-mono" style="color: var(--color-mute);">Tips</span>
          <h2 class="display-md" style="margin: 8px 0 0;">Getting accurate results.</h2>
        </div>
        <div class="tips-grid" style="margin-top: 32px;">
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">Disable mouse acceleration</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              Turn off "Enhance pointer precision" in Windows settings or disable acceleration in your mouse software for the most accurate results.
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">Use a flat surface</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              Place your mouse on a flat mousepad or desk surface. Uneven surfaces can cause tracking inconsistencies.
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">Test multiple times</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              Run 3-5 tests and compare results using the history panel. Consistent results indicate accurate measurement.
            </p>
          </div>
          <div class="card-soft tip-card">
            <h4 class="body-md" style="font-weight: 500; margin: 0 0 8px;">Calibrate your screen</h4>
            <p class="body-sm" style="color: var(--color-body); margin: 0;">
              Use the ruler calibration tool with your monitor's screen size and resolution for the most accurate distance reference on your display.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .analyzer-page {
    padding: 48px 0 0;
  }

  .page-header {
    margin-bottom: 40px;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .tip-card {
    padding: 24px;
  }

  @media (max-width: 768px) {
    .analyzer-page {
      padding: 32px 0 0;
    }

    .tips-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
